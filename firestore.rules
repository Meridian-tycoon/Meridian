rules_version = '2';
// Meridian Tycoon: public player profiles shown on other players' globes.
service cloud.firestore {
  match /databases/{database}/documents {
    function wcOff() {
      return exists(/databases/$(database)/documents/world/wcseason) ? get(/databases/$(database)/documents/world/wcseason).data.off : 0;
    }
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'col', 'home', 'hq', 'biz', 'nw', 'rank', 'loc', 'nb', 'nc', 'cid', 'gov', 'govC', 'govR', 'govS', 'govO', 'tk', 'sats', 'lw', 'pins', 'lastSeen'])
        && d.keys().hasAll(['name', 'col', 'lastSeen'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.col is string && d.col.matches('^#[0-9a-fA-F]{6}$')
        && (!('home' in d) || d.home == null || (d.home is int && d.home >= 0 && d.home < 10000))
        && (!('hq' in d) || (d.hq is list && d.hq.size() <= 50))
        && (!('biz' in d) || (d.biz is list && d.biz.size() <= 100))
        && (!('loc' in d) || d.loc == null || (d.loc is int && d.loc >= 0 && d.loc < 10000))
        && (!('nw' in d) || d.nw is number)
        && (!('rank' in d) || (d.rank is int && d.rank >= 1 && d.rank <= 1000))
        && (!('nb' in d) || (d.nb is int && d.nb >= 0 && d.nb <= 100000))
        && (!('gov' in d) || d.gov is bool)
        && (!('govC' in d) || (d.govC is string && d.govC.size() <= 40))
        && (!('govR' in d) || (d.govR is int && d.govR >= 0 && d.govR <= 2))
        && (!('govS' in d) || (d.govS is int && d.govS >= 0))
        && (!('govO' in d) || (d.govO is list && d.govO.size() <= 20))
        && (!('nc' in d) || (d.nc is int && d.nc >= 0 && d.nc <= 10000))
        && (!('sats' in d) || (d.sats is int && d.sats >= 0 && d.sats <= 3))
        && (!('lw' in d) || (d.lw is list && d.lw.size() <= 11))
        && (!('pins' in d) || (d.pins is list && d.pins.size() <= 300))
        && (!('tk' in d) || (d.tk is string && d.tk.matches('^[A-Z]{3,5}$')))
        && (!('cid' in d) || (d.cid is string && d.cid.size() > 0 && d.cid.size() <= 40
            && exists(/databases/$(database)/documents/cartels/$(d.cid))
            && request.auth.uid in get(/databases/$(database)/documents/cartels/$(d.cid)).data.members))
        && d.lastSeen == request.time;
    }

    // Live Air One evacuations: anyone may read; each user writes only their own, with checked fields.
    match /evac/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['f', 't', 'o', 'c', 'a', 'j', 'name'])
        && request.resource.data.f is int && request.resource.data.t is int
        && request.resource.data.o is number && request.resource.data.c is number && request.resource.data.a is number
        && request.resource.data.j is int && request.resource.data.j >= 0 && request.resource.data.j <= 6
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Live Ground One motorcades: anyone may read; each user writes only their own, with checked fields; deleted when the trip ends.
    match /g1trip/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['f', 't', 'o', 'a', 'j', 'name'])
        && request.resource.data.f is int && request.resource.data.t is int
        && request.resource.data.o is number && request.resource.data.a is number
        && request.resource.data.j is int && request.resource.data.j >= 0 && request.resource.data.j <= 12
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Player-vs-player launch warnings: the attacker creates one 30s before impact and deletes it after; everyone may read.
    match /launch/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'name', 'fc', 'tc', 'city', 'k', 'n', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.fc is string && request.resource.data.fc.size() <= 40
        && request.resource.data.tc is string && request.resource.data.tc.size() <= 40
        && request.resource.data.city is int && request.resource.data.k in ['msl', 'gas', 'nuke', 'icbm']
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 99
        && request.resource.data.at is int;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }

    // Anonymous war funding: a donation carries NO sender id. Any signed-in player may create one; only the master world
    // (developer save) may read and delete them, to add them to world/wfund. Nobody, the master included, can see who sent it.
    match /wfund/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['k', 'w', 's', 'to', 'vs', 'amt', 'at'])
        && request.resource.data.k in ['w', 'e', 'p']
        && request.resource.data.amt is int && request.resource.data.amt >= 100000 && request.resource.data.amt <= 10000000000000
        && ((request.resource.data.k in ['e', 'p']
             && request.resource.data.to is string && request.resource.data.to.size() <= 40
             && request.resource.data.vs is string && request.resource.data.vs.size() <= 40)
          || (request.resource.data.k == 'w'
             && request.resource.data.w is int && request.resource.data.s in ['a', 'b']
             && request.resource.data.to is string && request.resource.data.to.size() <= 40
             && request.resource.data.vs is string && request.resource.data.vs.size() <= 40))
        && request.resource.data.at == request.time;
      allow read, delete: if request.auth != null && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1';
    }
    // Shared Mars terraforming meter: written only by the master world, read by everyone.
    match /world/terra {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['tot', 'top', 'feed', 'updated'])
        && request.resource.data.tot is number && request.resource.data.tot >= 0
        && request.resource.data.top is map && request.resource.data.top.size() <= 30
        && request.resource.data.feed is list && request.resource.data.feed.size() <= 20
        && request.resource.data.updated == request.time;
    }
    // Terraforming contributions (no sender uid): any signed-in player creates one; only the master world reads and deletes them.
    match /terra/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['c', 'amt', 'at']) && request.resource.data.keys().hasAll(['c', 'amt', 'at'])
        && request.resource.data.c is string && request.resource.data.c.size() > 0 && request.resource.data.c.size() <= 40
        && request.resource.data.amt in [10000000, 100000000, 1000000000, 10000000000]
        && request.resource.data.at == request.time;
      allow read, delete: if request.auth != null && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1';
    }

    // World council: one season per real UTC week (week 0 = Mon 5 Jan 1970). Written only by the master world, read by everyone.
    match /world/council {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['season', 'rules', 'active', 'tally', 'last', 'n', 'updated'])
        && request.resource.data.season is int
        && request.resource.data.rules is list && request.resource.data.rules.size() <= 6
        && request.resource.data.active is map && request.resource.data.active.size() <= 6
        && request.resource.data.tally is map && request.resource.data.tally.size() <= 6
        && request.resource.data.last is map && request.resource.data.last.size() <= 6
        && request.resource.data.n is int
        && request.resource.data.updated == request.time;
    }
    // World Council Leader: one seat for the whole world. A player creates it once for themselves; nobody can take it over.
    // The holder may set a decree (dec) that overrides the council vote for next season.
    // Only the master world (Mark) can delete it to free the seat.
    // Player alliances: palliance/{a_b} with a < b (uids). Only the two players read or write it.
    // The proposer creates it pending (st 'p'); only the other side may accept (st 'on'). Each side only edits its own
    // country / name / intel fields (ca,na,ia for a; cb,nb,ib for b). Either side may delete it.
    function paValid(d) {
      return d.keys().hasOnly(['a', 'b', 'by', 'st', 'ca', 'cb', 'na', 'nb', 'ia', 'ib', 'at'])
        && d.keys().hasAll(['a', 'b', 'by', 'st', 'ca', 'cb', 'na', 'nb', 'ia', 'ib', 'at'])
        && d.a is string && d.b is string && d.a < d.b && d.by in [d.a, d.b]
        && d.st in ['p', 'on']
        && d.ca is string && d.ca.size() <= 40 && d.cb is string && d.cb.size() <= 40
        && d.na is string && d.na.size() <= 40 && d.nb is string && d.nb.size() <= 40
        && d.ia is map && d.ia.size() <= 30 && d.ib is map && d.ib.size() <= 30
        && d.at == request.time;
    }
    match /palliance/{id} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b);
      allow create: if request.auth != null && paValid(request.resource.data)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.st == 'p'
        && id == request.resource.data.a + '_' + request.resource.data.b;
      allow update: if request.auth != null && paValid(request.resource.data)
        && request.auth.uid in [resource.data.a, resource.data.b]
        && request.resource.data.a == resource.data.a && request.resource.data.b == resource.data.b
        && request.resource.data.by == resource.data.by
        && (request.resource.data.st == resource.data.st
            || (resource.data.st == 'p' && request.resource.data.st == 'on' && request.auth.uid != resource.data.by))
        && (request.auth.uid == resource.data.a
            ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'ca', 'na', 'ia', 'at'])
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'cb', 'nb', 'ib', 'at']));
      allow delete: if request.auth != null && request.auth.uid in [resource.data.a, resource.data.b];
    }

    // World council season offset: the World Council Leader can end the season early (off + 1, at most once a minute). Season = UTC week + off.
    match /world/wcseason {
      allow read: if true;
      allow create, update: if request.auth != null
        && (request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
          || (exists(/databases/$(database)/documents/world/wcleader) && get(/databases/$(database)/documents/world/wcleader).data.uid == request.auth.uid))
        && request.resource.data.keys().hasOnly(['off', 'ot', 'by']) && request.resource.data.keys().hasAll(['off', 'ot', 'by'])
        && request.resource.data.off is int
        && request.resource.data.off == (resource == null ? 1 : resource.data.off + 1)
        && request.resource.data.ot == request.time
        && (resource == null || request.time > resource.data.ot + duration.value(1, 'm'))
        && request.resource.data.by is string && request.resource.data.by.size() <= 40;
    }
    match /world/wcleader {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'c', 'at']) && request.resource.data.keys().hasAll(['uid', 'name', 'c', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.c is string && request.resource.data.c.size() > 0 && request.resource.data.c.size() <= 40
        && request.resource.data.at == request.time;
      // The leader's decree: only the holder, only the "dec" field, for the current week, pass (1) or block (0) per rule.
      // Hand-over: the holder gives the seat to another player whose own profile shows a government office in that country.
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'c', 'at']) && request.resource.data.keys().hasAll(['uid', 'name', 'c', 'at'])
        && request.resource.data.uid is string && request.resource.data.uid != request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.c is string && request.resource.data.c.size() > 0 && request.resource.data.c.size() <= 40
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/players/$(request.resource.data.uid))
        && get(/databases/$(database)/documents/players/$(request.resource.data.uid)).data.get('govR', -1) >= 0
        && get(/databases/$(database)/documents/players/$(request.resource.data.uid)).data.get('govC', '') == request.resource.data.c;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dec'])
        && request.resource.data.dec is map && request.resource.data.dec.keys().hasOnly(['w', 'v'])
        && request.resource.data.dec.w is int && request.resource.data.dec.w == math.floor((request.time.toMillis() / 86400000 - 4) / 7) + wcOff()
        && request.resource.data.dec.v is map && request.resource.data.dec.v.keys().hasOnly(['nuke', 'carbon', 'arms'])
        && request.resource.data.dec.v.values().hasOnly([0, 1]);
      allow delete: if request.auth != null && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1';
    }
    // Shared strike feed: a player posts strikes fired by or at them; everyone reads; the poster or Mark deletes.
    match /strikes/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'nm', 'k', 'f', 'c', 'i', 'at']) && request.resource.data.keys().hasAll(['uid', 'nm', 'k', 'f', 'c', 'i', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nm is string && request.resource.data.nm.size() <= 40
        && request.resource.data.k in ['msl', 'clu', 'gas', 'emp', 'nuke', 'hbomb', 'icbm']
        && request.resource.data.f is string && request.resource.data.f.size() <= 40
        && request.resource.data.c is int && request.resource.data.c >= 0 && request.resource.data.c < 10000
        && request.resource.data.i in [0, 1]
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1');
    }
    // World council votes: doc id "<week>_<uid>", own doc only, only in the current week, yes/no per rule; an update may only add rules.
    // Only the master world reads them (to tally).
    match /wcvote/{id} {
      function wcOk(d) {
        return d.keys().hasOnly(['w', 'c', 'v', 'at']) && d.keys().hasAll(['w', 'c', 'v', 'at'])
          && d.w is int && d.w == math.floor((request.time.toMillis() / 86400000 - 4) / 7) + wcOff()
          && id == string(d.w) + '_' + request.auth.uid
          && d.c is string && d.c.size() > 0 && d.c.size() <= 40
          && d.v is map && d.v.size() >= 1 && d.v.keys().hasOnly(['nuke', 'carbon', 'arms'])
          && d.v.values().hasOnly([0, 1])
          && d.at == request.time;
      }
      allow create: if request.auth != null && wcOk(request.resource.data);
      allow update: if request.auth != null && wcOk(request.resource.data)
        && request.resource.data.w == resource.data.w
        && request.resource.data.v.diff(resource.data.v).changedKeys().size() == 0
        && request.resource.data.v.diff(resource.data.v).removedKeys().size() == 0;
      allow read: if request.auth != null && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1';
    }
    // Shared war funding totals, escalation meters and feed: written only by the master world, read by everyone. No donor ids.
    match /world/wfund {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['tot', 'b', 'tens', 'feed', 'ww', 'updated'])
        && (!('ww' in request.resource.data) || (request.resource.data.ww is map && request.resource.data.ww.keys().hasOnly(['n', 'd'])))
        && request.resource.data.tot is map && request.resource.data.b is map && request.resource.data.tens is map
        && request.resource.data.feed is list && request.resource.data.feed.size() <= 40
        && request.resource.data.updated == request.time;
    }

    // Weekly auction house: one doc per lot, id "<week>_<lot>" (week 0 = Mon 5 Jan 1970 UTC). Signed-in players read; a bid
    // replaces the doc with the bidder as high, must beat the old high by more than 5%, and only lands inside its own week.
    function validBid(id, d) {
      return d.keys().hasOnly(['hi', 'uid', 'name', 'at']) && d.keys().hasAll(['hi', 'uid', 'name', 'at'])
        && d.uid == request.auth.uid
        && d.hi is int && d.hi > 0 && d.hi <= 9000000000000000
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.at == request.time
        && id.matches('^[0-9]{1,7}_[0-2]$')
        && request.time.toMillis() >= (int(id.split('_')[0]) * 7 + 4) * 86400000
        && request.time.toMillis() < (int(id.split('_')[0]) * 7 + 11) * 86400000;
    }
    match /auc/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && validBid(id, request.resource.data);
      allow update: if request.auth != null && validBid(id, request.resource.data)
        && request.resource.data.hi * 100 > resource.data.hi * 105;
    }

    match /players/{uid} {
      // Anyone (signed in or not) may read profiles. Profiles never contain emails.
      allow read: if true;
      // Each signed-in user may only write their own profile, with checked fields.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && validProfile(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Private cloud saves: only the owner can read or write their own save.
    function validSave(d) {
      return d.keys().hasOnly(['ver', 'sid', 'n', 'd', 'updated', 'at', 'device', 'nw', 'day', 'biz', 'len'])
        && d.keys().hasAll(['ver', 'sid', 'n', 'd', 'updated'])
        && d.ver is int && d.sid is string && d.sid.size() <= 40
        && d.n is int && d.n >= 0 && d.n <= 30
        && d.d is string && d.d.size() <= 700000
        && d.updated == request.time
        && (!('device' in d) || (d.device is string && d.device.size() <= 60))
        && (!('at' in d) || d.at is number)
        && (!('nw' in d) || d.nw is number)
        && (!('day' in d) || d.day is number)
        && (!('biz' in d) || d.biz is number)
        && (!('len' in d) || d.len is int);
    }
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && validSave(request.resource.data);
      match /parts/{part} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && part.matches('^[0-9]{1,2}$')
          && request.resource.data.keys().hasOnly(['sid', 'd'])
          && request.resource.data.sid is string && request.resource.data.sid.size() <= 40
          && request.resource.data.d is string && request.resource.data.d.size() <= 700000;
      }
    }
    // Money transfers between players: sender creates, recipient reads + deletes (claims). No updates.
    match /transfers/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'amt', 'at', 'note'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'to', 'amt', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to.size() > 0 && request.resource.data.to.size() <= 128
        && request.resource.data.to != request.auth.uid
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 20
        && request.resource.data.amt is int && request.resource.data.amt > 0 && request.resource.data.amt <= 500000000000
        && request.resource.data.at == request.time
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 40));
      allow read, delete: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
    // Shared world rivals: one live list written only by the developer's save (the master world), readable by everyone.
    // Rules cannot loop, so each of the 8 rivals (RIVALS.length in index.html) is checked by index; nw is a number (any sign), cities a list of at most 10.
    function validRival(r) {
      return r is map && r.keys().hasOnly(['nw', 'cities']) && r.keys().hasAll(['nw', 'cities'])
        && r.nw is number && r.cities is list && r.cities.size() <= 10;
    }
    match /world/rivals {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['list', 'updated'])
        && request.resource.data.list is list && request.resource.data.list.size() == 8
        && validRival(request.resource.data.list[0]) && validRival(request.resource.data.list[1])
        && validRival(request.resource.data.list[2]) && validRival(request.resource.data.list[3])
        && validRival(request.resource.data.list[4]) && validRival(request.resource.data.list[5])
        && validRival(request.resource.data.list[6]) && validRival(request.resource.data.list[7])
        && request.resource.data.updated == request.time;
    }
    // Bot company "Meridian Freight" (rule-based, simulated only by the master world = the developer's save).
    // world/bot: only the developer writes it, everyone reads it. Rules cannot loop, so the lists are only size-capped.
    match /world/bot {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['name', 'col', 'nw', 'nc', 'trucks', 'free', 'cities', 'stock', 'updated'])
        && request.resource.data.keys().hasAll(['name', 'col', 'nw', 'nc', 'trucks', 'free', 'cities', 'stock', 'updated'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.col is string && request.resource.data.col.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.nw is number
        && request.resource.data.nc is int && request.resource.data.nc >= 0 && request.resource.data.nc <= 10
        && request.resource.data.trucks is int && request.resource.data.trucks >= 0 && request.resource.data.trucks <= 100
        && request.resource.data.free is int && request.resource.data.free >= 0 && request.resource.data.free <= 100
        && request.resource.data.cities is list && request.resource.data.cities.size() <= 10
        && request.resource.data.stock is list && request.resource.data.stock.size() <= 10
        && request.resource.data.updated == request.time;
    }
    // Shared wars (living wars on the map): only the developer's save (the master world) writes world/wars, everyone reads it.
    match /world/wars {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['list', 'ruler', 'tl', 'gp', 'updated'])
        && request.resource.data.keys().hasAll(['list', 'ruler', 'updated'])
        && request.resource.data.list is list && request.resource.data.list.size() <= 30
        && request.resource.data.ruler is map
        && (!('gp' in request.resource.data) || request.resource.data.gp is map)
        && request.resource.data.updated == request.time;
    }
    // Shared market (stock + crypto prices and the XRP boom): the developer's save writes world/mkt, everyone reads it.
    // Any signed-in player may set only xb (boom start) to the server time, and only when no boom ran in the last 5 minutes.
    match /world/mkt {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['px', 'xb', 'updated'])
        && request.resource.data.px is map && request.resource.data.px.size() <= 40
        && (request.resource.data.xb == null || request.resource.data.xb is timestamp)
        && request.resource.data.updated == request.time;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xb'])
        && request.resource.data.xb == request.time
        && (resource.data.xb == null || resource.data.xb < request.time - duration.value(5, 'm'));
    }
    // Shared market history (index.html mkhPublish): the developer's save writes daily candles world/mkh, everyone reads it.
    match /world/mkh {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['k', 'day', 'updated'])
        && request.resource.data.k is map && request.resource.data.k.size() <= 40
        && request.resource.data.day is int
        && request.resource.data.updated == request.time;
    }
    // Weekly world events (index.html wev*): one event per UTC week w (week 0 = Mon 5 Jan 1970), scored Mon 00:00 to Sat 23:59 UTC.
    // world/evt: the master world (developer's save) publishes the current event, the server-wide total and the top 10; everyone reads it.
    function validEvt(d) {
      return d.keys().hasOnly(['w', 'k', 'goal', 'prog', 'n', 'top', 'fin', 'last', 'updated'])
        && d.keys().hasAll(['w', 'k', 'goal', 'prog', 'n', 'top', 'updated'])
        && d.w is int && d.w >= 0 && d.k in ['rush', 'tour', 'harvest', 'build', 'tech', 'oil']
        && d.goal is int && d.goal > 0 && d.prog is int && d.prog >= 0 && d.n is int && d.n >= 0
        && d.top is list && d.top.size() <= 10
        && (!('fin' in d) || d.fin is bool)
        && (!('last' in d) || d.last == null || d.last is map)
        && d.updated == request.time;
    }
    match /world/evt {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && validEvt(request.resource.data);
    }
    // evt/{w}/score/{uid}: a player's score for week w, written only by that player and only inside the week. The score never goes down,
    // rises by at most 5,000,000 points per write and writes are 30 s apart. Everyone reads (board + goal); nobody deletes.
    function validEvtScore(w, d) {
      return w.matches('^[0-9]{1,7}$')
        && d.keys().hasOnly(['name', 's', 'at']) && d.keys().hasAll(['name', 's', 'at'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.s is int && d.s >= 0 && d.s <= 1000000000000
        && d.at == request.time
        && request.time.toMillis() >= (int(w) * 7 + 4) * 86400000
        && request.time.toMillis() < (int(w) * 7 + 10) * 86400000;
    }
    function evtStep(x) {
      return x >= 0 && x <= 5000000;
    }
    match /evt/{w}/score/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && validEvtScore(w, request.resource.data) && request.resource.data.s <= 5000000;
      allow update: if request.auth != null && request.auth.uid == uid
        && validEvtScore(w, request.resource.data) && evtStep(request.resource.data.s - resource.data.s)
        && request.time > resource.data.at + duration.value(30, 's');
    }
    // A player's troops fighting in a shared war: one doc per player, written and removed only by that player, read by everyone.
    match /wjoin/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['w', 's', 'n', 'name', 'c', 'at'])
        && request.resource.data.keys().hasAll(['w', 's', 'n', 'name', 'c', 'at'])
        && request.resource.data.w is int && request.resource.data.w > 0
        && request.resource.data.s in ['a', 'b']
        && request.resource.data.n is number && request.resource.data.n >= 0 && request.resource.data.n <= 1000000000
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.c is string && request.resource.data.c.size() <= 40
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Requests to the bot (hire a truck "haul", "buy" or "sell" goods): the player creates one (money/goods are taken from the player's own save first),
    // the master reads them all, answers with a botres document and deletes the request. No updates, so a request cannot be changed after sending.
    match /botreq/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'kind', 'city', 'dest', 'g', 'q', 'amt', 'at'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'kind', 'city', 'g', 'q', 'amt', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 20
        && request.resource.data.kind in ['buy', 'sell', 'haul']
        && request.resource.data.city is int && request.resource.data.city >= 0 && request.resource.data.city < 10000
        && (!('dest' in request.resource.data) || (request.resource.data.dest is int && request.resource.data.dest >= 0 && request.resource.data.dest < 10000))
        && request.resource.data.g is string && request.resource.data.g.size() > 0 && request.resource.data.g.size() <= 20
        && request.resource.data.q is int && request.resource.data.q >= 1 && request.resource.data.q <= 1000000
        && request.resource.data.amt is int && request.resource.data.amt >= 0 && request.resource.data.amt <= 1000000
        && request.resource.data.at == request.time;
      allow read: if request.auth != null
        && (request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1' || resource.data.from == request.auth.uid);
      allow delete: if request.auth != null && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1';
    }
    // Bot replies: created only by the developer's save, once per request id (no update, so a reply cannot be re-sent over an existing one).
    // The addressed player reads it, credits cash/goods in their own save, then deletes it.
    match /botres/{id} {
      allow create: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['to', 'ok', 'cash', 'city', 'g', 'q', 'msg', 'at'])
        && request.resource.data.keys().hasAll(['to', 'ok', 'cash', 'msg', 'at'])
        && request.resource.data.to is string && request.resource.data.to.size() > 0 && request.resource.data.to.size() <= 128
        && request.resource.data.ok is bool
        && request.resource.data.cash is int && request.resource.data.cash >= 0 && request.resource.data.cash <= 2000000
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 60
        && (!('city' in request.resource.data) || (request.resource.data.city is int && request.resource.data.city >= 0 && request.resource.data.city < 10000))
        && (!('g' in request.resource.data) || (request.resource.data.g is string && request.resource.data.g.size() <= 20))
        && (!('q' in request.resource.data) || (request.resource.data.q is int && request.resource.data.q >= 1 && request.resource.data.q <= 1000000))
        && request.resource.data.at == request.time;
      allow read, delete: if request.auth != null
        && (resource.data.to == request.auth.uid || request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1');
    }
    // Online freight board: a shipper posts a haul (goods + pay are escrowed in the shipper's own save); one carrier accepts; the carrier marks it done; the shipper pays through transfers.
    // Accept = an update that adds {carrier, carrierName, acc, eta} and is only allowed while no carrier is set, so of two racing carriers exactly one commits.
    // Done = the carrier adds {done} with server time between eta and dl. Cancel = shipper deletes before acceptance. Delete after done must come in the same batch as
    // transfers/f<id> paying the carrier the full pay (existsAfter/getAfter), so a haul cannot be settled without paying. An accepted haul that is not done by dl may be deleted by the shipper (refund).
    // If the shipper never settles, the carrier may claim 24 h after done (see Claim); a claimed haul can no longer be paid by transfer, so it is never paid twice.
    // ---------- Fuel market (index.html fx*/fo*): rig owners list fuel, other players order it ----------
    // fuelsell/{uid}: a rig owner's listing. fuelord/{id}: an order from buyer `by` to seller `to`. Cash and fuel move only inside each player's own save.
    match /fuelsell/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'fuel', 'px', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.fuel is int && request.resource.data.fuel >= 0 && request.resource.data.fuel <= 1000000000000
        && request.resource.data.px is number && request.resource.data.px > 0 && request.resource.data.px <= 1000000
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /fuelord/{id} {
      allow read: if request.auth != null && (resource.data.by == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['by', 'byName', 'to', 'toName', 'q', 'px', 'city', 'st', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid && request.resource.data.to.size() <= 128
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 20
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 20
        && request.resource.data.q is int && request.resource.data.q >= 100 && request.resource.data.q <= 1000000000000
        && request.resource.data.px is number && request.resource.data.px > 0 && request.resource.data.px <= 1000000
        && request.resource.data.city is int && request.resource.data.city >= 0 && request.resource.data.city < 10000
        && request.resource.data.st == 'open' && request.resource.data.at == request.time;
      // the seller fills or declines an open order
      allow update: if request.auth != null && resource.data.to == request.auth.uid && resource.data.st == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])
        && request.resource.data.st in ['filled', 'declined'];
      // the buyer cancels an open order, or marks a filled / declined one settled
      allow update: if request.auth != null && resource.data.by == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])
        && ((resource.data.st == 'open' && request.resource.data.st == 'cancel')
            || (resource.data.st in ['filled', 'declined'] && request.resource.data.st == 'done'));
      allow delete: if request.auth != null && resource.data.by == request.auth.uid && resource.data.st in ['done', 'cancel'];
    }
    // ---------- Stock exchanges (index.html ex*): one exchange server-wide (world/nyse), other players route trades through it ----------
    // exch/{uid}: the owner's public listing. excom/{id}: a 0.1% commission written by a trader for exchange owner `to`; the owner claims it by deleting it
    // (cash moves only inside the owner's own save). amt is capped and tied to the reported trade volume (amt <= vol / 1000).
    // world/nyse: the one New York Stock Exchange on the server. The first player to claim it owns it; nobody else can take it over.
    // The owner can rename it, release it (delete) or offer it to one player (to, toName, price). That player buys it by writing
    // exsale/{sellerUid} (the payment, collected by the seller) and taking over world/nyse in the same transaction.
    function nyseOk(d) {
      return d.keys().hasOnly(['uid', 'name', 'own', 'at', 'to', 'toName', 'price'])
        && d.name is string && d.name.size() >= 3 && d.name.size() <= 30
        && d.own is string && d.own.size() <= 20
        && d.at == request.time;
    }
    match /world/nyse {
      allow read: if true;
      allow create: if request.auth != null && nyseOk(request.resource.data)
        && request.resource.data.uid == request.auth.uid && !('to' in request.resource.data);
      allow update: if request.auth != null && nyseOk(request.resource.data) && (
        (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
          && (!('to' in request.resource.data)
            || (request.resource.data.to is string && request.resource.data.to != request.auth.uid && request.resource.data.to.size() <= 128
              && request.resource.data.toName is string && request.resource.data.toName.size() <= 20
              && request.resource.data.price is int && request.resource.data.price >= 1 && request.resource.data.price <= 1000000000000000)))
        || ('to' in resource.data && resource.data.to == request.auth.uid
          && request.resource.data.uid == request.auth.uid && request.resource.data.name == resource.data.name
          && !('to' in request.resource.data) && !('price' in request.resource.data) && !('toName' in request.resource.data)
          && getAfter(/databases/$(database)/documents/exsale/$(resource.data.uid)).data.by == request.auth.uid
          && getAfter(/databases/$(database)/documents/exsale/$(resource.data.uid)).data.amt == resource.data.price));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // exsale/{sellerUid}: the buyer's payment for the exchange; the seller claims it by deleting it (cash moves only inside the seller's own save)
    match /exsale/{seller} {
      allow read: if request.auth != null && (request.auth.uid == seller || resource.data.by == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['by', 'byName', 'to', 'amt', 'at'])
        && request.resource.data.by == request.auth.uid && request.resource.data.to == seller
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 20
        && get(/databases/$(database)/documents/world/nyse).data.uid == seller
        && get(/databases/$(database)/documents/world/nyse).data.to == request.auth.uid
        && request.resource.data.amt == get(/databases/$(database)/documents/world/nyse).data.price
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == seller;
    }
    match /exch/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && get(/databases/$(database)/documents/world/nyse).data.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'own', 'fee', 'vol', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 30
        && request.resource.data.own is string && request.resource.data.own.size() <= 20
        && request.resource.data.fee is number && request.resource.data.fee >= 0 && request.resource.data.fee <= 0.01
        && request.resource.data.vol is number && request.resource.data.vol >= 0 && request.resource.data.vol <= 1000000000000000
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /excom/{id} {
      allow read: if request.auth != null && (resource.data.by == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['by', 'byName', 'to', 'amt', 'vol', 'at', 'k', 'tk'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid && request.resource.data.to.size() <= 128
        && exists(/databases/$(database)/documents/exch/$(request.resource.data.to))
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 20
        && request.resource.data.amt is int && request.resource.data.amt >= 1 && request.resource.data.amt <= 50000000
        && request.resource.data.vol is int && request.resource.data.vol <= 1000000000000000 && (request.resource.data.amt * 1000 <= request.resource.data.vol
          || (request.resource.data.get('k', '') == 'ipo' && request.resource.data.tk is string && request.resource.data.tk.size() <= 5 && request.resource.data.amt * 100 <= request.resource.data.vol))
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
    match /freight/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['shipper', 'shipperName', 'g', 'q', 'from', 'to', 'pay', 'dl', 'at'])
        && request.resource.data.keys().hasAll(['shipper', 'shipperName', 'g', 'q', 'from', 'to', 'pay', 'dl', 'at'])
        && request.resource.data.shipper == request.auth.uid
        && request.resource.data.shipperName is string && request.resource.data.shipperName.size() <= 20
        && request.resource.data.g is string && request.resource.data.g.size() > 0 && request.resource.data.g.size() <= 20
        && request.resource.data.q is int && request.resource.data.q >= 1 && request.resource.data.q <= 5000
        && request.resource.data.from is int && request.resource.data.from >= 0 && request.resource.data.from < 10000
        && request.resource.data.to is int && request.resource.data.to >= 0 && request.resource.data.to < 10000
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.pay is int && request.resource.data.pay >= 100 && request.resource.data.pay <= 1000000
        && request.resource.data.dl is int
        && request.resource.data.dl > request.time.toMillis() + 60000
        && request.resource.data.dl <= request.time.toMillis() + 259200000 + 300000
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && (
        (!('carrier' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['carrier', 'carrierName', 'acc', 'eta'])
          && request.resource.data.keys().hasAll(['carrier', 'carrierName', 'acc', 'eta'])
          && request.resource.data.carrier == request.auth.uid
          && request.auth.uid != resource.data.shipper
          && request.resource.data.carrierName is string && request.resource.data.carrierName.size() <= 20
          && request.resource.data.acc == request.time
          && request.resource.data.eta is int
          && request.resource.data.eta >= request.time.toMillis() + 60000
          && request.resource.data.eta <= resource.data.dl
          && resource.data.dl > request.time.toMillis())
        ||
        ('carrier' in resource.data && !('done' in resource.data)
          && resource.data.carrier == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
          && request.resource.data.done == request.time
          && request.time.toMillis() >= resource.data.eta
          && request.time.toMillis() <= resource.data.dl)
        ||
        // Claim = the shipper never settled: 24 h after done, the carrier of that haul may stamp {claim} once and takes the pay the shipper escrowed at posting.
        ('done' in resource.data && !('claim' in resource.data)
          && resource.data.carrier == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claim'])
          && request.resource.data.claim == request.time
          && request.time > resource.data.done + duration.value(24, 'h')));
      allow delete: if request.auth != null && ((resource.data.shipper == request.auth.uid && (
        !('carrier' in resource.data)
        || ('claim' in resource.data && !existsAfter(/databases/$(database)/documents/transfers/$('f' + id)))
        || ('done' in resource.data && !('claim' in resource.data)
            && existsAfter(/databases/$(database)/documents/transfers/$('f' + id))
            && getAfter(/databases/$(database)/documents/transfers/$('f' + id)).data.to == resource.data.carrier
            && getAfter(/databases/$(database)/documents/transfers/$('f' + id)).data.from == request.auth.uid
            && getAfter(/databases/$(database)/documents/transfers/$('f' + id)).data.amt == resource.data.pay)
        || (!('done' in resource.data) && request.time.toMillis() > resource.data.dl)))
        // Stale cleanup: anyone signed in may delete a post nobody accepted once it is a day past its deadline (the shipper's save refunds it on return).
        || (!('carrier' in resource.data) && request.time.toMillis() > resource.data.dl + 86400000));
    }
    // ---- Cartels (online syndicates). Doc id of cartels/{id} is the boss's uid, so a boss founds at most one. ----
    function validCartel(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 20
        && d.tag is string && d.tag.matches('^[A-Z0-9]{2,4}$')
        && d.col is string && d.col.matches('^#[0-9a-fA-F]{6}$')
        && d.open is bool
        && d.bossName is string && d.bossName.size() <= 20
        && (d.fix == null || (d.fix is map && d.fix.keys().hasOnly(['c', 'g']) && d.fix.keys().hasAll(['c', 'g'])
            && d.fix.c is int && d.fix.c >= 0 && d.fix.c < 10000
            && d.fix.g is string && d.fix.g.size() > 0 && d.fix.g.size() <= 20));
    }
    // the ledger entry that belongs to treasury change number seq of cartel cid (as it will be after the batch)
    function ledAfter(cid, seq) {
      return getAfter(/databases/$(database)/documents/cled/$(cid + '_' + string(seq))).data;
    }
    function payTransferOk(cid, seq, boss, to, amt) {
      return existsAfter(/databases/$(database)/documents/transfers/$('c' + cid + '_' + string(seq)))
        && getAfter(/databases/$(database)/documents/transfers/$('c' + cid + '_' + string(seq))).data.to == to
        && getAfter(/databases/$(database)/documents/transfers/$('c' + cid + '_' + string(seq))).data.from == boss
        && getAfter(/databases/$(database)/documents/transfers/$('c' + cid + '_' + string(seq))).data.amt == amt;
    }
    function isMember(cid) {
      return request.auth.uid in get(/databases/$(database)/documents/cartels/$(cid)).data.members;
    }
    function isBoss(cid) {
      return get(/databases/$(database)/documents/cartels/$(cid)).data.boss == request.auth.uid;
    }
    match /cartels/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['name', 'tag', 'col', 'boss', 'bossName', 'open', 'members', 'tre', 'seq', 'fix', 'fixAt', 'at'])
        && request.resource.data.keys().hasAll(['name', 'tag', 'col', 'boss', 'bossName', 'open', 'members', 'tre', 'seq', 'fix', 'fixAt', 'at'])
        && validCartel(request.resource.data)
        && request.resource.data.boss == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.tre == 0 && request.resource.data.seq == 0
        && request.resource.data.fix == null && request.resource.data.fixAt == 0
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && (
        // boss: settings and price fixing (price fixing may change once per 12 hours)
        (request.auth.uid == resource.data.boss
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'tag', 'col', 'open', 'bossName', 'fix', 'fixAt'])
          && validCartel(request.resource.data)
          && request.resource.data.fixAt is int
          && (('fix' in request.resource.data.diff(resource.data).affectedKeys())
              ? (request.resource.data.fixAt >= request.time.toMillis() - 300000
                 && request.resource.data.fixAt <= request.time.toMillis() + 300000
                 && request.time.toMillis() >= resource.data.fixAt + 43200000)
              : !('fixAt' in request.resource.data.diff(resource.data).affectedKeys())))
        ||
        // boss removes a member (the boss stays)
        (request.auth.uid == resource.data.boss
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
          && request.resource.data.members.hasAll([resource.data.boss]))
        ||
        // a member (not the boss) leaves
        (request.auth.uid != resource.data.boss && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
          && !(request.auth.uid in request.resource.data.members))
        ||
        // a player joins themselves; needs the boss's invite, which must be consumed (deleted) in the same batch
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 12
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()).size() == 0
          && request.auth.uid in request.resource.data.members
          && exists(/databases/$(database)/documents/cjoin/$(id + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/cjoin/$(id + '_' + request.auth.uid)).data.kind == 'invite'
          && !existsAfter(/databases/$(database)/documents/cjoin/$(id + '_' + request.auth.uid)))
        ||
        // treasury: exactly one ledger entry per change (member deposit, or boss payout)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tre', 'seq'])
          && request.resource.data.seq == resource.data.seq + 1
          && request.resource.data.tre >= 0 && request.resource.data.tre <= 1000000000
          && existsAfter(/databases/$(database)/documents/cled/$(id + '_' + string(request.resource.data.seq)))
          && ledAfter(id, request.resource.data.seq).cid == id
          && ledAfter(id, request.resource.data.seq).uid == request.auth.uid
          && ((ledAfter(id, request.resource.data.seq).kind == 'in'
                && request.auth.uid in resource.data.members
                && request.resource.data.tre == resource.data.tre + ledAfter(id, request.resource.data.seq).amt)
              || (ledAfter(id, request.resource.data.seq).kind == 'out'
                && request.auth.uid == resource.data.boss
                && ledAfter(id, request.resource.data.seq).to in resource.data.members
                && request.resource.data.tre == resource.data.tre - ledAfter(id, request.resource.data.seq).amt
                && (ledAfter(id, request.resource.data.seq).to == request.auth.uid
                    || payTransferOk(id, request.resource.data.seq, request.auth.uid, ledAfter(id, request.resource.data.seq).to, ledAfter(id, request.resource.data.seq).amt))))));
      // the boss may disband an empty cartel with an empty treasury
      allow delete: if request.auth != null && request.auth.uid == resource.data.boss
        && resource.data.members.size() == 1 && resource.data.tre == 0;
    }
    // Join invitations (kind 'invite', written by the boss) and join requests (kind 'request', written by the player, approved by the boss flipping it to 'invite').
    match /cjoin/{jid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['cid', 'uid', 'name', 'kind', 'at'])
        && request.resource.data.keys().hasAll(['cid', 'uid', 'name', 'kind', 'at'])
        && request.resource.data.cid is string && request.resource.data.uid is string
        && jid == request.resource.data.cid + '_' + request.resource.data.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.at == request.time
        && !(request.resource.data.uid in get(/databases/$(database)/documents/cartels/$(request.resource.data.cid)).data.members)
        && ((request.resource.data.kind == 'request' && request.resource.data.uid == request.auth.uid
              && get(/databases/$(database)/documents/cartels/$(request.resource.data.cid)).data.open == true)
            || (request.resource.data.kind == 'invite' && isBoss(request.resource.data.cid)));
      allow update: if request.auth != null && isBoss(resource.data.cid)
        && resource.data.kind == 'request'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind', 'at'])
        && request.resource.data.kind == 'invite' && request.resource.data.at == request.time;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.uid || isBoss(resource.data.cid));
    }
    // Permanent, create-only treasury ledger. Entry n of a cartel can only be created together with the cartel update that moves seq from n-1 to n.
    match /cled/{lid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['cid', 'seq', 'kind', 'uid', 'to', 'amt', 'at'])
        && request.resource.data.keys().hasAll(['cid', 'seq', 'kind', 'uid', 'amt', 'at'])
        && request.resource.data.cid is string && request.resource.data.seq is int && request.resource.data.seq >= 1
        && lid == request.resource.data.cid + '_' + string(request.resource.data.seq)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['in', 'out']
        && request.resource.data.amt is int && request.resource.data.amt >= 1 && request.resource.data.amt <= 1000000
        && request.resource.data.at == request.time
        && (request.resource.data.kind == 'out'
            ? ('to' in request.resource.data && request.resource.data.to is string)
            : !('to' in request.resource.data))
        && get(/databases/$(database)/documents/cartels/$(request.resource.data.cid)).data.seq == request.resource.data.seq - 1
        && getAfter(/databases/$(database)/documents/cartels/$(request.resource.data.cid)).data.seq == request.resource.data.seq;
      allow update, delete: if false;
    }
    // Members-only chat. One message per ~4 s per player: the same batch must stamp cmlast/{uid} with the server time and the previous stamp must be old enough.
    match /cmsg/{mid} {
      allow read: if request.auth != null && isMember(resource.data.cid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['cid', 'uid', 'name', 'txt', 'at'])
        && request.resource.data.keys().hasAll(['cid', 'uid', 'name', 'txt', 'at'])
        && request.resource.data.cid is string && isMember(request.resource.data.cid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.txt is string && request.resource.data.txt.size() >= 1 && request.resource.data.txt.size() <= 120
        && request.resource.data.at == request.time
        && existsAfter(/databases/$(database)/documents/cmlast/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/cmlast/$(request.auth.uid)).data.at == request.time
        && (!exists(/databases/$(database)/documents/cmlast/$(request.auth.uid))
            || get(/databases/$(database)/documents/cmlast/$(request.auth.uid)).data.at.toMillis() < request.time.toMillis() - 4000);
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isBoss(resource.data.cid));
      allow update: if false;
    }
    match /cmlast/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      // the owner may remove it when deleting their account
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Government raid on a price-fixing cartel: at most one per cartel per day. The raider's own profile must carry gov == true (published by the client while it holds an office; self-reported, so this blocks casual raids, not a determined cheat).
    match /craid/{cid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['cid', 'by', 'byName', 'at'])
        && request.resource.data.keys().hasAll(['cid', 'by', 'byName', 'at'])
        && request.resource.data.cid == cid && request.resource.data.by == request.auth.uid
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 20
        && request.resource.data.at == request.time
        && !(request.auth.uid in get(/databases/$(database)/documents/cartels/$(cid)).data.members)
        && get(/databases/$(database)/documents/cartels/$(cid)).data.fix != null
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.get('gov', false) == true
        && (resource == null || resource.data.at.toMillis() < request.time.toMillis() - 86400000);
      allow delete: if false;
    }
    // Nuclear mining permit applications. The applicant creates a pending request addressed to the player
    // governing that country; only that governor may approve or refuse it; the applicant may withdraw it.
    match /permits/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && id.matches(request.auth.uid + '_[A-Za-z0-9]{0,30}')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'c', 'by', 'st', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.c is string && request.resource.data.c.size() <= 40
        && request.resource.data.by is string && request.resource.data.by != request.auth.uid
        && request.resource.data.st == 'pending'
        && request.resource.data.at == request.time;
      // The addressed governor decides once: only st/by/byName may change, and by stays the governor.
      allow update: if request.auth != null
        && resource.data.st == 'pending'
        && resource.data.by == request.auth.uid
        && request.resource.data.by == request.auth.uid
        && request.resource.data.st in ['approved', 'denied']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'byName'])
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 20;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Government announcements: a player announces their own rise to power to everyone; nobody edits them.
    match /govann/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'c', 'how', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'c', 'how', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.c is string && request.resource.data.c.size() <= 40
        && request.resource.data.how in ['elect', 'buy', 'transfer']
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    // Country sales between players: the seller offers a country they hold to one player at any price;
    // only that buyer may mark it paid or declined; the seller deletes it after being credited.
    match /ctysale/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && id.matches(request.auth.uid + '_[A-Za-z0-9]{0,30}')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'c', 'to', 'toName', 'price', 'st', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 20
        && request.resource.data.c is string && request.resource.data.c.size() <= 40
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 1000000000000000
        && request.resource.data.st == 'open'
        && request.resource.data.at == request.time;
      allow update: if request.auth != null
        && resource.data.st == 'open'
        && resource.data.to == request.auth.uid
        && request.resource.data.st in ['paid', 'no']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st']);
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || resource.data.to == request.auth.uid);
    }
    // Cabinet (Military dashboard > Cabinet): office holders of one country. Office comes from the player's own public profile
    // (govC / govR, published by the game), so this keeps out non-holders, not a determined cheat.
    function me() {
      return get(/databases/$(database)/documents/players/$(request.auth.uid)).data;
    }
    function govOf(c) {
      return request.auth != null && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && me().get('govC', '') == c && me().get('govR', -1) >= 0;
    }
    function govAny() {
      return request.auth != null && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && me().get('govR', -1) >= 0;
    }
    function govLeader(c) {
      return govOf(c) && me().get('govR', -1) == 2;
    }
    function validGovMsg(d, c) {
      return d.keys().hasOnly(['uid', 'name', 'c', 'r', 'txt', 'at'])
        && d.keys().hasAll(['uid', 'name', 'c', 'r', 'txt', 'at'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() <= 20
        && d.c == c && d.r is int && d.r >= 0 && d.r <= 2
        && d.txt is string && d.txt.size() >= 1 && d.txt.size() <= 160
        && d.at == request.time
        && getAfter(/databases/$(database)/documents/gvlast/$(request.auth.uid)).data.at == request.time
        && (!exists(/databases/$(database)/documents/gvlast/$(request.auth.uid))
            || get(/databases/$(database)/documents/gvlast/$(request.auth.uid)).data.at.toMillis() < request.time.toMillis() - 3000);
    }
    match /gvlast/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Chat for every office holder in the world.
    match /govmsg/{mid} {
      allow read: if govAny();
      allow create: if govAny() && validGovMsg(request.resource.data, me().get('govC', ''));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    function cabDep(c) {
      return /databases/$(database)/documents/cab/$(c)/dep/$(request.auth.uid);
    }
    function cabOld(path, k) {
      return exists(path) ? get(path).data.get(k, 0) : 0;
    }
    function cabNew(path, k) {
      return existsAfter(path) ? getAfter(path).data.get(k, 0) : 0;
    }
    // a fund moves by exactly as much as the caller's own deposit for that fund
    function cabDelta(c, k) {
      return cabNew(/databases/$(database)/documents/cab/$(c), k) - cabOld(/databases/$(database)/documents/cab/$(c), k)
        == cabNew(cabDep(c), k) - cabOld(cabDep(c), k);
    }
    // Shared funds of one country's cabinet: members add money; spending happens in a transaction by the Leader.
    match /cab/{c} {
      allow read: if govOf(c);
      allow create, update: if govOf(c)
        && request.resource.data.keys().hasOnly(['war', 'arms', 'wto'])
        && (!('war' in request.resource.data) || (request.resource.data.war is number && request.resource.data.war >= 0 && request.resource.data.war <= 1000000000000))
        && (!('arms' in request.resource.data) || (request.resource.data.arms is number && request.resource.data.arms >= 0 && request.resource.data.arms <= 1000000000000))
        && (!('wto' in request.resource.data) || (request.resource.data.wto is number && request.resource.data.wto >= 0 && request.resource.data.wto <= 1000000000000))
        // the Leader may spend; anyone else changes each fund only by the same amount as their own deposit record (cab/{c}/dep/{uid})
        && (govLeader(c) || (cabDelta(c, 'war') && cabDelta(c, 'arms') && cabDelta(c, 'wto')));
      allow delete: if false;

      // each member's own running deposit per fund; changes only together with the fund itself
      match /dep/{uid} {
        allow read: if govOf(c) && request.auth.uid == uid;
        allow create, update: if govOf(c) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['war', 'arms', 'wto'])
          && request.resource.data.get('war', 0) is number && request.resource.data.get('war', 0) >= 0
          && request.resource.data.get('arms', 0) is number && request.resource.data.get('arms', 0) >= 0
          && request.resource.data.get('wto', 0) is number && request.resource.data.get('wto', 0) >= 0
          && ((cabDelta(c, 'war') && cabDelta(c, 'arms') && cabDelta(c, 'wto'))
              // the Leader may withdraw any fund money, so their own record may only go down without matching the fund
              || (govLeader(c) && resource != null
                  && request.resource.data.get('war', 0) <= resource.data.get('war', 0)
                  && request.resource.data.get('arms', 0) <= resource.data.get('arms', 0)
                  && request.resource.data.get('wto', 0) <= resource.data.get('wto', 0)));
        allow delete: if false;
      }
      match /msg/{mid} {
        allow read: if govOf(c);
        allow create: if govOf(c) && validGovMsg(request.resource.data, c);
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
      // Bills: majority of seats passes, the Leader may veto, the Leader marks spending bills done.
      match /bill/{bid} {
        allow read: if govOf(c);
        allow create: if govOf(c)
          && request.resource.data.keys().hasOnly(['k', 'key', 'val', 'tg', 'by', 'byName', 'at', 'exp', 'seats', 'yes', 'no', 'st', 'done'])
          && request.resource.data.k in ['law', 'war', 'arms', 'wto']
          && request.resource.data.key is string && request.resource.data.key.size() <= 12
          && request.resource.data.val is int && request.resource.data.val >= 0 && request.resource.data.val <= 9
          && request.resource.data.tg is string && request.resource.data.tg.size() <= 40
          && request.resource.data.by == request.auth.uid
          && request.resource.data.byName is string && request.resource.data.byName.size() <= 20
          && request.resource.data.at == request.time
          && request.resource.data.exp is timestamp
          && request.resource.data.seats is int && request.resource.data.seats >= 1 && request.resource.data.seats <= 10
          && request.resource.data.yes == [request.auth.uid] && request.resource.data.no == []
          && request.resource.data.st == 'open' && request.resource.data.done == false;
        // a vote adds only your own uid to yes or no, while the bill is open and before its deadline
        allow update: if govOf(c) && resource.data.st == 'open' && request.time < resource.data.exp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yes', 'no', 'st'])
          && request.resource.data.yes.toSet().difference(resource.data.yes.toSet()).hasOnly([request.auth.uid])
          && request.resource.data.no.toSet().difference(resource.data.no.toSet()).hasOnly([request.auth.uid])
          && !(request.auth.uid in resource.data.yes) && !(request.auth.uid in resource.data.no)
          && request.resource.data.st in ['open', 'passed', 'failed'];
        allow update: if govLeader(c) && resource.data.st == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])
          && request.resource.data.st == 'vetoed';
        allow update: if govLeader(c) && resource.data.done == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
          && request.resource.data.done == true;
        allow delete: if false;
      }
    }
    // ---------- Company IPOs (index.html ipo*): a player lists their company, other players trade its shares ----------
    // Prices are never stored: every client computes them from the listing (earnings x multiple, sentiment, market mood, seeded noise).
    // Cash moves only inside each player's own save: buyers pay into, and sellers are paid from, the public pool (same trust model as
    // transfers / auc / freight). These rules keep other players' holdings safe: share counts, caps, rate limits and server times.
    // ipotk/{TK}: ticker reservation, created in the same batch as the founder's listing. ipo/{uid}: the listing. ipo/{uid}/hold/{h}: one holding.
    function ipoL(uid) {
      return /databases/$(database)/documents/ipo/$(uid);
    }
    function ipoH(uid, h) {
      return /databases/$(database)/documents/ipo/$(uid)/hold/$(h);
    }
    function msSince(t) {
      return request.time.toMillis() - t.toMillis();
    }
    function isDev() {
      return request.auth != null && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1';
    }
    function validIpo(d) {
      return d.keys().hasOnly(['tk', 'name', 'col', 'N', 'pub', 'pool', 'E', 'E72', 'mx', 'bk', 'ref', 'fAt', 'sent', 'sentAt', 'soAt', 'st', 'outPx', 'at', 'dps', 'dpsAt'])
        && d.keys().hasAll(['tk', 'name', 'col', 'N', 'pub', 'pool', 'E', 'E72', 'mx', 'bk', 'ref', 'fAt', 'sent', 'sentAt', 'st', 'at'])
        && d.tk is string && d.tk.matches('^[A-Z]{3,5}$')
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.col is string && d.col.matches('^#[0-9a-fA-F]{6}$')
        && d.N is int && d.N >= 1000000 && d.N <= 100000000
        && d.pub is int && d.pub >= 0 && d.pub * 100 <= d.N * 49
        && d.pool is int && d.pool >= 0 && d.pool <= d.pub
        && d.E is number && d.E >= 0 && d.E <= 1000000000000
        && d.E72 is number && d.E72 >= 0 && d.E72 <= 1000000000000
        && d.mx is number && d.mx >= 0.8 && d.mx <= 1.3
        && d.bk is number && d.bk >= 0 && d.bk <= 1000000000000000
        && d.ref is number && d.ref > 0
        && d.sent is number && d.sent >= 0.8 && d.sent <= 1.25
        && d.st in ['live', 'halt', 'delisted']
        && (!('outPx' in d) || (d.outPx is number && d.outPx >= 0))
        && (!('soAt' in d) || d.soAt is timestamp)
        && (!('dps' in d) || (d.dps is number && d.dps >= 0))
        && (!('dpsAt' in d) || d.dpsAt is timestamp)
        && d.fAt is timestamp && d.sentAt is timestamp && d.at is timestamp;
    }
    // Founder: earnings at most every 10 min (E rises at most 10%/h and 1.5x per write, book 1.5x, ref +-30%), buyback from the
    // unheld pool (<= 5% of shares a write), secondary offering (<= 10%, once per 7 days), one-way delisting with a buyout price
    // of at least 120 h of earnings a share and 70% of ref. Only the developer halts. Nothing changes once delisted.
    function ipoFounderOk(o, n) {
      let ch = n.diff(o).affectedKeys();
      return o.st != 'delisted'
        && ch.hasOnly(['name', 'col', 'E', 'E72', 'mx', 'bk', 'ref', 'fAt', 'pub', 'pool', 'soAt', 'st', 'outPx', 'dps', 'dpsAt'])
        && (!ch.hasAny(['E', 'E72', 'mx', 'bk', 'ref', 'fAt']) || (n.fAt == request.time && msSince(o.fAt) >= 600000
            && (n.E - o.E - 1000) * 36000000 <= o.E * msSince(o.fAt) && n.E <= o.E * 1.5 + 1000
            && n.bk <= o.bk * 1.5 + 1000000 && n.ref <= o.ref * 1.3 && n.ref >= o.ref * 0.7))
        && (n.pub != o.pub || n.pool == o.pool)
        && (n.pub >= o.pub || (o.pub - n.pub == o.pool - n.pool && (o.pub - n.pub) * 20 <= o.N))
        && (n.pub <= o.pub || (n.pub - o.pub == n.pool - o.pool && (n.pub - o.pub) * 10 <= o.N
            && n.soAt == request.time && (!('soAt' in o) || msSince(o.soAt) >= 604800000)))
        && (!ch.hasAny(['st', 'outPx']) || (n.st == 'delisted' && n.outPx * o.N >= o.E * 120 && n.outPx >= o.ref * 0.7))
        && (!ch.hasAny(['dps', 'dpsAt']) || ipoDpsOk(o, n));
    }
    // Phase 3 dividends: dps (cumulative dividend per public share) only rises, stamped with server time, and at most
    // (3 x earnings + 10k) an hour of elapsed time since the last raise (48 h max), spread over all N shares.
    function ipoDpsOk(o, n) {
      let ms = math.min(msSince(o.get('dpsAt', o.fAt)), 172800000);
      return n.dpsAt == request.time && n.dps is number && n.dps > o.get('dps', 0)
        && (n.dps - o.get('dps', 0)) * o.N <= (o.E * 3 + 10000) * ms / 3600000;
    }
    // Another player's trade: only pool and sentiment change, and the pool moves exactly opposite to their hold doc in the same batch.
    // No trading while halted; no buying once delisted or when the founder has not published for 14 days.
    // Sentiment moves at most 3 x (share of the company traded), plus 5% an hour of drift back to 1.0.
    function ipoTradeOk(uid, o, n) {
      let h = ipoH(uid, request.auth.uid);
      let dq = (existsAfter(h) ? getAfter(h).data.q : 0) - (exists(h) ? get(h).data.q : 0);
      return n.diff(o).affectedKeys().hasOnly(['pool', 'sent', 'sentAt'])
        && dq != 0 && n.pool == o.pool - dq && o.st != 'halt'
        && (dq < 0 || (o.st == 'live' && msSince(o.fAt) < 1209600000))
        && (o.st == 'delisted' ? (n.sent == o.sent && n.sentAt == o.sentAt)
            : (n.sentAt == request.time
              && math.abs(n.sent - o.sent) <= 0.002 + 3.0 * math.abs(dq) / o.N + 0.05 * msSince(o.sentAt) / 3600000));
    }
    // 24 h trading window per player and company: d0 = window start (server time), dq = shares bought + sold in it, at most 5% of N.
    function ipoDayOk(r, n, N) {
      let moved = math.abs(n.q - (r == null ? 0 : r.data.q));
      return n.d0 is timestamp && n.dq is int
        && ((r != null && msSince(r.data.d0) < 86400000) ? (n.d0 == r.data.d0 && n.dq == r.data.dq + moved)
            : (n.d0 == request.time && n.dq == moved))
        && n.dq * 20 <= N;
    }
    match /ipotk/{tk} {
      allow read: if true;
      allow create: if request.auth != null && tk.matches('^[A-Z]{3,5}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && getAfter(ipoL(request.auth.uid)).data.tk == tk;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /ipo/{uid} {
      allow read: if true;
      // listing: the ticker is reserved for this founder in the same batch; valuation at most 440 h of earnings plus book value
      allow create: if request.auth != null && request.auth.uid == uid
        && validIpo(request.resource.data)
        && getAfter(/databases/$(database)/documents/ipotk/$(request.resource.data.tk)).data.uid == uid
        && request.resource.data.st == 'live' && request.resource.data.pool == request.resource.data.pub
        && request.resource.data.sent >= 1.0 && request.resource.data.sent <= 1.15
        && !('soAt' in request.resource.data) && !('outPx' in request.resource.data)
        && request.resource.data.get('dps', 0) == 0 && (!('dpsAt' in request.resource.data) || request.resource.data.dpsAt == request.time)
        && request.resource.data.ref * request.resource.data.N <= request.resource.data.E * 440 + request.resource.data.bk + 1
        && request.resource.data.at == request.time && request.resource.data.fAt == request.time
        && request.resource.data.sentAt == request.time;
      allow update: if request.auth != null && validIpo(request.resource.data) && (
        (request.auth.uid == uid && ipoFounderOk(resource.data, request.resource.data))
        || (request.auth.uid != uid && ipoTradeOk(uid, resource.data, request.resource.data))
        || (isDev() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'outPx'])));
      // the founder removes a delisted listing once every holder has sold back to the pool
      allow delete: if request.auth != null && request.auth.uid == uid
        && resource.data.st == 'delisted' && resource.data.pool == resource.data.pub;
      // a holding: written only by its holder (never the founder), at most 10% of the company, 1 write a minute,
      // 5% traded per 24 h (except cashing out all of a delisted company), and the listing's pool must move by exactly
      // the opposite amount in the same batch. dps = the listing's dividend accumulator the holder last collected up to. Never deleted.
      match /hold/{h} {
        allow read: if request.auth != null;
        // dividend marker only: never down, never past the listing's published dps
        allow update: if request.auth != null && request.auth.uid == h
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dps'])
          && request.resource.data.dps is number && request.resource.data.dps >= resource.data.get('dps', 0)
          && request.resource.data.dps <= get(ipoL(uid)).data.get('dps', 0);
        allow create, update: if request.auth != null && request.auth.uid == h && h != uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'q', 'avg', 'd0', 'dq', 'at', 'dps'])
          && (!('dps' in request.resource.data) || (request.resource.data.dps is number && request.resource.data.dps >= 0
              && request.resource.data.dps <= getAfter(ipoL(uid)).data.get('dps', 0)))
          && request.resource.data.uid == h
          && request.resource.data.name is string && request.resource.data.name.size() <= 20
          && request.resource.data.q is int && request.resource.data.q >= 0
          && request.resource.data.q * 10 <= get(ipoL(uid)).data.N
          && request.resource.data.avg is number && request.resource.data.avg >= 0
          && request.resource.data.at == request.time
          && (resource == null || msSince(resource.data.at) >= 60000)
          && (ipoDayOk(resource, request.resource.data, get(ipoL(uid)).data.N)
              || (get(ipoL(uid)).data.st == 'delisted' && request.resource.data.q == 0
                  && request.resource.data.d0 is timestamp && request.resource.data.dq is int))
          && getAfter(ipoL(uid)).data.pool == get(ipoL(uid)).data.pool - (request.resource.data.q - (resource == null ? 0 : resource.data.q));
      }
    }
    // "My holdings" after a reinstall: collection-group query on hold.uid (needs the fieldOverride in firestore.indexes.json)
    match /{path=**}/hold/{h} {
      allow read: if request.auth != null;
    }
    // Moon and Mars colonies: one doc per site, id "<planet>_<site>". Owned by a country, run by its governing player (uid).
    // Create: a player whose public profile says they govern that country. Update: the runner (country can't change);
    // a new governor of the same country (inherit); a governor of another country whose atk beats the effective defence
    // (takeover: def, halved when the doc's own supply has run out); or a repelled attacker that may only lower the garrison.
    function colUpLv(d, k) {
      return d.get('up', {}).get(k, 0);
    }
    function validColony(d) {
      return d.keys().hasOnly(['p', 's', 'c', 'uid', 'name', 'col', 'lv', 'sup', 'supAt', 'gar', 'ore', 'oreAt', 'auto', 'def', 'atk', 'updated', 'up', 'tour', 'crewTo'])
        && d.keys().hasAll(['p', 's', 'c', 'uid', 'lv', 'sup', 'supAt', 'gar', 'ore', 'def', 'updated'])
        && d.p in ['moon', 'mars'] && d.s is int && d.s >= 0 && d.s < 16
        && d.c is string && d.c.size() > 0 && d.c.size() <= 40
        && d.uid is string && d.uid.size() <= 128
        && (!('name' in d) || (d.name is string && d.name.size() <= 20))
        && (!('col' in d) || (d.col is string && d.col.size() <= 7))
        && d.lv is int && d.lv >= 1 && d.lv <= 5
        && d.sup is number && d.sup >= 0 && d.sup <= 120
        && d.supAt is int && (!('oreAt' in d) || d.oreAt is int)
        && d.gar is map && d.gar.keys().hasOnly(['armored', 'drones'])
        && d.gar.armored is int && d.gar.armored >= 0 && d.gar.armored <= 100000
        && d.gar.drones is int && d.gar.drones >= 0 && d.gar.drones <= 100000
        && d.ore is number && d.ore >= 0 && d.ore <= 100000
        && (!('auto' in d) || (d.auto is int && d.auto >= 0 && d.auto <= 1))
        && d.def is number && d.def >= 0 && d.def <= 10000000
        && (!('atk' in d) || (d.atk is number && d.atk >= 0 && d.atk <= 10000000))
        && (!('up' in d) || (d.up is map && d.up.keys().hasOnly(['dome', 'driver', 'lab', 'turret'])))
        && colUpLv(d, 'dome') is int && colUpLv(d, 'dome') >= 0 && colUpLv(d, 'dome') <= 3 && colUpLv(d, 'dome') <= d.lv
        && colUpLv(d, 'driver') is int && colUpLv(d, 'driver') >= 0 && colUpLv(d, 'driver') <= 3 && colUpLv(d, 'driver') <= d.lv
        && colUpLv(d, 'lab') is int && colUpLv(d, 'lab') >= 0 && colUpLv(d, 'lab') <= 3 && colUpLv(d, 'lab') <= d.lv
        && colUpLv(d, 'turret') is int && colUpLv(d, 'turret') >= 0 && colUpLv(d, 'turret') <= 3 && colUpLv(d, 'turret') <= d.lv
        && (!('tour' in d) || (d.tour is int && d.tour >= 0 && d.tour <= 1000000))
        && (!('crewTo' in d) || (d.crewTo is int && d.crewTo >= 0 && d.crewTo <= request.time.toMillis() + 72000000))
        && d.updated is int;
    }
    // stored def is full-strength defence and may not claim more than level, turrets and garrison give
    function colDefOk(d) {
      return d.def <= 10 * d.lv + 20 * colUpLv(d, 'turret') + 15 * d.gar.armored + 5 * d.gar.drones + 1;
    }
    function colUpNoMore(n, o) {
      return colUpLv(n, 'dome') <= colUpLv(o, 'dome') && colUpLv(n, 'driver') <= colUpLv(o, 'driver')
        && colUpLv(n, 'lab') <= colUpLv(o, 'lab') && colUpLv(n, 'turret') <= colUpLv(o, 'turret');
    }
    // supply left on the stored doc right now (habitat dome: -30% use per level), as the client's colSup
    function colSupplied(r) {
      return r.sup - (request.time.toMillis() - r.supAt) / 3600000.0 * (1.0 - 0.3 * colUpLv(r, 'dome')) > 0;
    }
    function colBeats(r, atk) {
      return atk is number && ((colSupplied(r) && atk > r.def) || (!colSupplied(r) && atk * 2 > r.def));
    }
    match /colonies/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && validColony(request.resource.data) && colDefOk(request.resource.data)
        && govOf(request.resource.data.c)
        && request.resource.data.lv <= 4 && request.resource.data.get('tour', 0) == 0
        && colUpLv(request.resource.data, 'dome') + colUpLv(request.resource.data, 'driver') + colUpLv(request.resource.data, 'lab') + colUpLv(request.resource.data, 'turret') == 0
        && id == request.resource.data.p + '_' + string(request.resource.data.s);
      allow update: if request.auth != null && validColony(request.resource.data)
        && request.resource.data.p == resource.data.p && request.resource.data.s == resource.data.s
        && ((resource.data.uid == request.auth.uid && request.resource.data.c == resource.data.c && colDefOk(request.resource.data))
          || (request.resource.data.uid == request.auth.uid && request.resource.data.c != resource.data.c && colDefOk(request.resource.data)
              && govOf(request.resource.data.c) && colBeats(resource.data, request.resource.data.get('atk', 0))
              && request.resource.data.lv <= resource.data.lv && request.resource.data.ore <= resource.data.ore + 1
              && colUpNoMore(request.resource.data, resource.data))
          || (request.resource.data.uid == request.auth.uid && request.resource.data.c == resource.data.c && colDefOk(request.resource.data)
              && govOf(resource.data.c))
          || (govAny() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gar', 'updated'])
              && request.resource.data.gar.armored <= resource.data.gar.armored
              && request.resource.data.gar.drones <= resource.data.gar.drones));
    }

    // Colony missions in flight (public so every player sees ships heading for a site). Created and deleted by the sender.
    match /cmission/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['c', 'uid', 'p', 'site', 't', 'eta', 'atk', 'updated'])
        && request.resource.data.c is string && request.resource.data.c.size() > 0 && request.resource.data.c.size() <= 40
        && request.resource.data.p in ['moon', 'mars']
        && request.resource.data.site is int && request.resource.data.site >= 0 && request.resource.data.site < 16
        && request.resource.data.t in ['found', 'supply', 'expand', 'garrison', 'assault', 'build', 'crew', 'tour']
        && request.resource.data.eta is int
        && request.resource.data.atk is number && request.resource.data.atk >= 0 && request.resource.data.atk <= 10000000
        && request.resource.data.updated is int;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Ore exchange. oreask/{id}: a seller's lot (the ore waits in the seller's own save). oresale/{askId_buyerUid}: written by the
    // buyer in the same transaction that lowers (or, for the last units, deletes) the lot; the seller reads it, credits cash, deletes it.
    function oxSale(id) {
      return /databases/$(database)/documents/oresale/$(id + '_' + request.auth.uid);
    }
    function oxSaleMatches(id, r, q) {
      return existsAfter(oxSale(id)) && getAfter(oxSale(id)).data.q == q && getAfter(oxSale(id)).data.ask == id
        && getAfter(oxSale(id)).data.to == r.uid && getAfter(oxSale(id)).data.g == r.g && getAfter(oxSale(id)).data.px == r.px;
    }
    match /oreask/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'g', 'q', 'px', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'g', 'q', 'px', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.g is string && request.resource.data.g.size() >= 1 && request.resource.data.g.size() <= 12
        && request.resource.data.q is int && request.resource.data.q >= 1 && request.resource.data.q <= 100000
        && request.resource.data.px is number && request.resource.data.px > 0 && request.resource.data.px <= 100000000
        && request.resource.data.at == request.time;
      // a buyer (never the seller) takes some units: only q goes down, and the matching sale doc is written in the same batch
      allow update: if request.auth != null && request.auth.uid != resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['q'])
        && request.resource.data.q is int && request.resource.data.q >= 1 && request.resource.data.q < resource.data.q
        && oxSaleMatches(id, resource.data, resource.data.q - request.resource.data.q);
      // the seller cancels, or a buyer takes the last units (with the matching sale doc)
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid
        || (request.auth.uid != resource.data.uid && oxSaleMatches(id, resource.data, resource.data.q)));
    }
    match /oresale/{id} {
      // only the seller deletes (claims): a buyer deleting it would take the ore without the seller ever being paid
      allow read: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.by == request.auth.uid);
      allow delete: if request.auth != null && resource.data.to == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['to', 'by', 'byName', 'ask', 'g', 'q', 'px', 'amt', 'at'])
        && request.resource.data.keys().hasAll(['to', 'by', 'byName', 'ask', 'g', 'q', 'px', 'amt', 'at'])
        && request.resource.data.by == request.auth.uid && request.resource.data.to != request.auth.uid
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 20
        && request.resource.data.ask is string && id == request.resource.data.ask + '_' + request.auth.uid
        && request.resource.data.q is int && request.resource.data.q >= 1 && request.resource.data.q <= 100000
        && request.resource.data.px is number && request.resource.data.amt is number
        && request.resource.data.amt == request.resource.data.q * request.resource.data.px
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/oreask/$(request.resource.data.ask))
        && get(/databases/$(database)/documents/oreask/$(request.resource.data.ask)).data.uid == request.resource.data.to
        && get(/databases/$(database)/documents/oreask/$(request.resource.data.ask)).data.g == request.resource.data.g
        && get(/databases/$(database)/documents/oreask/$(request.resource.data.ask)).data.px == request.resource.data.px
        && ((existsAfter(/databases/$(database)/documents/oreask/$(request.resource.data.ask))
             && get(/databases/$(database)/documents/oreask/$(request.resource.data.ask)).data.q
                - getAfter(/databases/$(database)/documents/oreask/$(request.resource.data.ask)).data.q == request.resource.data.q)
          || (!existsAfter(/databases/$(database)/documents/oreask/$(request.resource.data.ask))
             && get(/databases/$(database)/documents/oreask/$(request.resource.data.ask)).data.q == request.resource.data.q));
    }

    // Player goods exchange (city Player market). gdask/{id}: a seller's lot in city c (the goods wait in the seller's own save). gdsale/{askId_buyerUid}: written by the
    // buyer in the same transaction that lowers (or, for the last units, deletes) the lot; the seller reads it, credits cash, deletes it.
    function gxSale(id) {
      return /databases/$(database)/documents/gdsale/$(id + '_' + request.auth.uid);
    }
    function gxSaleMatches(id, r, q) {
      return existsAfter(gxSale(id)) && getAfter(gxSale(id)).data.q == q && getAfter(gxSale(id)).data.ask == id
        && getAfter(gxSale(id)).data.to == r.uid && getAfter(gxSale(id)).data.g == r.g && getAfter(gxSale(id)).data.c == r.c && getAfter(gxSale(id)).data.px == r.px;
    }
    match /gdask/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'c', 'g', 'q', 'px', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'c', 'g', 'q', 'px', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.c is int && request.resource.data.c >= 0 && request.resource.data.c <= 1000
        && request.resource.data.g is string && request.resource.data.g.size() >= 1 && request.resource.data.g.size() <= 12
        && request.resource.data.q is int && request.resource.data.q >= 1 && request.resource.data.q <= 1000000000
        && request.resource.data.px is number && request.resource.data.px > 0 && request.resource.data.px <= 1000000000000
        && request.resource.data.at == request.time;
      // a buyer (never the seller) takes some units: only q goes down, and the matching sale doc is written in the same batch
      allow update: if request.auth != null && request.auth.uid != resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['q'])
        && request.resource.data.q is int && request.resource.data.q >= 1 && request.resource.data.q < resource.data.q
        && gxSaleMatches(id, resource.data, resource.data.q - request.resource.data.q);
      // the seller cancels, or a buyer takes the last units (with the matching sale doc)
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid
        || (request.auth.uid != resource.data.uid && gxSaleMatches(id, resource.data, resource.data.q)));
    }
    match /gdsale/{id} {
      // only the seller deletes (claims): a buyer deleting it would take the ore without the seller ever being paid
      allow read: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.by == request.auth.uid);
      allow delete: if request.auth != null && resource.data.to == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['to', 'by', 'byName', 'ask', 'c', 'g', 'q', 'px', 'amt', 'at'])
        && request.resource.data.keys().hasAll(['to', 'by', 'byName', 'ask', 'c', 'g', 'q', 'px', 'amt', 'at'])
        && request.resource.data.by == request.auth.uid && request.resource.data.to != request.auth.uid
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 20
        && request.resource.data.ask is string && id == request.resource.data.ask + '_' + request.auth.uid
        && request.resource.data.q is int && request.resource.data.q >= 1 && request.resource.data.q <= 1000000000
        && request.resource.data.px is number && request.resource.data.amt is number
        && request.resource.data.amt == request.resource.data.q * request.resource.data.px
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/gdask/$(request.resource.data.ask))
        && get(/databases/$(database)/documents/gdask/$(request.resource.data.ask)).data.uid == request.resource.data.to
        && get(/databases/$(database)/documents/gdask/$(request.resource.data.ask)).data.g == request.resource.data.g
        && get(/databases/$(database)/documents/gdask/$(request.resource.data.ask)).data.c == request.resource.data.c
        && get(/databases/$(database)/documents/gdask/$(request.resource.data.ask)).data.px == request.resource.data.px
        && ((existsAfter(/databases/$(database)/documents/gdask/$(request.resource.data.ask))
             && get(/databases/$(database)/documents/gdask/$(request.resource.data.ask)).data.q
                - getAfter(/databases/$(database)/documents/gdask/$(request.resource.data.ask)).data.q == request.resource.data.q)
          || (!existsAfter(/databases/$(database)/documents/gdask/$(request.resource.data.ask))
             && get(/databases/$(database)/documents/gdask/$(request.resource.data.ask)).data.q == request.resource.data.q));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
