rules_version = '2';
// Meridian Tycoon: public player profiles shown on other players' globes.
service cloud.firestore {
  match /databases/{database}/documents {
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'col', 'home', 'hq', 'biz', 'nw', 'rank', 'loc', 'nb', 'nc', 'cid', 'gov', 'govC', 'govR', 'govS', 'lastSeen'])
        && d.keys().hasAll(['name', 'col', 'lastSeen'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.col is string && d.col.matches('^#[0-9a-fA-F]{6}$')
        && (!('home' in d) || d.home == null || (d.home is int && d.home >= 0 && d.home < 10000))
        && (!('hq' in d) || (d.hq is list && d.hq.size() <= 50))
        && (!('biz' in d) || (d.biz is list && d.biz.size() <= 100))
        && (!('loc' in d) || d.loc == null || (d.loc is int && d.loc >= 0 && d.loc < 10000))
        && (!('nw' in d) || d.nw is number)
        && (!('rank' in d) || (d.rank is int && d.rank >= 1 && d.rank <= 1000))
        && (!('nb' in d) || (d.nb is int && d.nb >= 0 && d.nb <= 100000))
        && (!('gov' in d) || d.gov is bool)
        && (!('govC' in d) || (d.govC is string && d.govC.size() <= 40))
        && (!('govR' in d) || (d.govR is int && d.govR >= 0 && d.govR <= 2))
        && (!('govS' in d) || (d.govS is int && d.govS >= 0))
        && (!('nc' in d) || (d.nc is int && d.nc >= 0 && d.nc <= 10000))
        && (!('cid' in d) || (d.cid is string && d.cid.size() > 0 && d.cid.size() <= 40
            && exists(/databases/$(database)/documents/cartels/$(d.cid))
            && request.auth.uid in get(/databases/$(database)/documents/cartels/$(d.cid)).data.members))
        && d.lastSeen == request.time;
    }

    // Live Air One evacuations: anyone may read; each user writes only their own, with checked fields.
    match /evac/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['f', 't', 'o', 'c', 'a', 'j', 'name'])
        && request.resource.data.f is int && request.resource.data.t is int
        && request.resource.data.o is number && request.resource.data.c is number && request.resource.data.a is number
        && request.resource.data.j is int && request.resource.data.j >= 0 && request.resource.data.j <= 6
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Player-vs-player launch warnings: the attacker creates one 30s before impact and deletes it after; everyone may read.
    match /launch/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'name', 'fc', 'tc', 'city', 'k', 'n', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.fc is string && request.resource.data.fc.size() <= 40
        && request.resource.data.tc is string && request.resource.data.tc.size() <= 40
        && request.resource.data.city is int && request.resource.data.k in ['msl', 'gas', 'nuke', 'icbm']
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 99
        && request.resource.data.at is int;
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }

    // Anonymous war funding: a donation carries NO sender id. Any signed-in player may create one; only the master world
    // (developer save) may read and delete them, to add them to world/wfund. Nobody, the master included, can see who sent it.
    match /wfund/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['k', 'w', 's', 'to', 'vs', 'amt', 'at'])
        && request.resource.data.k in ['w', 'e']
        && request.resource.data.amt is int && request.resource.data.amt >= 100000 && request.resource.data.amt <= 10000000000000
        && ((request.resource.data.k == 'e'
             && request.resource.data.to is string && request.resource.data.to.size() <= 40
             && request.resource.data.vs is string && request.resource.data.vs.size() <= 40)
          || (request.resource.data.k == 'w'
             && request.resource.data.w is int && request.resource.data.s in ['a', 'b']
             && request.resource.data.to is string && request.resource.data.to.size() <= 40
             && request.resource.data.vs is string && request.resource.data.vs.size() <= 40))
        && request.resource.data.at == request.time;
      allow read, delete: if request.auth != null && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1';
    }
    // Shared war funding totals, escalation meters and feed: written only by the master world, read by everyone. No donor ids.
    match /world/wfund {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['tot', 'b', 'tens', 'feed', 'updated'])
        && request.resource.data.tot is map && request.resource.data.b is map && request.resource.data.tens is map
        && request.resource.data.feed is list && request.resource.data.feed.size() <= 40
        && request.resource.data.updated == request.time;
    }

    match /players/{uid} {
      // Anyone (signed in or not) may read profiles. Profiles never contain emails.
      allow read: if true;
      // Each signed-in user may only write their own profile, with checked fields.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && validProfile(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Private cloud saves: only the owner can read or write their own save.
    function validSave(d) {
      return d.keys().hasOnly(['ver', 'sid', 'n', 'd', 'updated', 'at', 'device', 'nw', 'day', 'biz', 'len'])
        && d.keys().hasAll(['ver', 'sid', 'n', 'd', 'updated'])
        && d.ver is int && d.sid is string && d.sid.size() <= 40
        && d.n is int && d.n >= 0 && d.n <= 30
        && d.d is string && d.d.size() <= 700000
        && d.updated == request.time
        && (!('device' in d) || (d.device is string && d.device.size() <= 60))
        && (!('at' in d) || d.at is number)
        && (!('nw' in d) || d.nw is number)
        && (!('day' in d) || d.day is number)
        && (!('biz' in d) || d.biz is number)
        && (!('len' in d) || d.len is int);
    }
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && validSave(request.resource.data);
      match /parts/{part} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && part.matches('^[0-9]{1,2}$')
          && request.resource.data.keys().hasOnly(['sid', 'd'])
          && request.resource.data.sid is string && request.resource.data.sid.size() <= 40
          && request.resource.data.d is string && request.resource.data.d.size() <= 700000;
      }
    }
    // Money transfers between players: sender creates, recipient reads + deletes (claims). No updates.
    match /transfers/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'amt', 'at', 'note'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'to', 'amt', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to.size() > 0 && request.resource.data.to.size() <= 128
        && request.resource.data.to != request.auth.uid
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 20
        && request.resource.data.amt is int && request.resource.data.amt > 0 && request.resource.data.amt <= 1000000
        && request.resource.data.at == request.time
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 40));
      allow read, delete: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
    // Shared world rivals: one live list written only by the developer's save (the master world), readable by everyone.
    // Rules cannot loop, so each of the 8 rivals (RIVALS.length in index.html) is checked by index; nw is a number (any sign), cities a list of at most 10.
    function validRival(r) {
      return r is map && r.keys().hasOnly(['nw', 'cities']) && r.keys().hasAll(['nw', 'cities'])
        && r.nw is number && r.cities is list && r.cities.size() <= 10;
    }
    match /world/rivals {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['list', 'updated'])
        && request.resource.data.list is list && request.resource.data.list.size() == 8
        && validRival(request.resource.data.list[0]) && validRival(request.resource.data.list[1])
        && validRival(request.resource.data.list[2]) && validRival(request.resource.data.list[3])
        && validRival(request.resource.data.list[4]) && validRival(request.resource.data.list[5])
        && validRival(request.resource.data.list[6]) && validRival(request.resource.data.list[7])
        && request.resource.data.updated == request.time;
    }
    // Bot company "Meridian Freight" (rule-based, simulated only by the master world = the developer's save).
    // world/bot: only the developer writes it, everyone reads it. Rules cannot loop, so the lists are only size-capped.
    match /world/bot {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['name', 'col', 'nw', 'nc', 'trucks', 'free', 'cities', 'stock', 'updated'])
        && request.resource.data.keys().hasAll(['name', 'col', 'nw', 'nc', 'trucks', 'free', 'cities', 'stock', 'updated'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.col is string && request.resource.data.col.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.nw is number
        && request.resource.data.nc is int && request.resource.data.nc >= 0 && request.resource.data.nc <= 10
        && request.resource.data.trucks is int && request.resource.data.trucks >= 0 && request.resource.data.trucks <= 100
        && request.resource.data.free is int && request.resource.data.free >= 0 && request.resource.data.free <= 100
        && request.resource.data.cities is list && request.resource.data.cities.size() <= 10
        && request.resource.data.stock is list && request.resource.data.stock.size() <= 10
        && request.resource.data.updated == request.time;
    }
    // Shared wars (living wars on the map): only the developer's save (the master world) writes world/wars, everyone reads it.
    match /world/wars {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['list', 'ruler', 'updated'])
        && request.resource.data.keys().hasAll(['list', 'ruler', 'updated'])
        && request.resource.data.list is list && request.resource.data.list.size() <= 30
        && request.resource.data.ruler is map
        && request.resource.data.updated == request.time;
    }
    // Shared market (stock + crypto prices and the XRP boom): the developer's save writes world/mkt, everyone reads it.
    // Any signed-in player may set only xb (boom start) to the server time, and only when no boom ran in the last 5 minutes.
    match /world/mkt {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['px', 'xb', 'updated'])
        && request.resource.data.px is map && request.resource.data.px.size() <= 40
        && (request.resource.data.xb == null || request.resource.data.xb is timestamp)
        && request.resource.data.updated == request.time;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xb'])
        && request.resource.data.xb == request.time
        && (resource.data.xb == null || resource.data.xb < request.time - duration.value(5, 'm'));
    }
    // A player's troops fighting in a shared war: one doc per player, written and removed only by that player, read by everyone.
    match /wjoin/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['w', 's', 'n', 'name', 'c', 'at'])
        && request.resource.data.keys().hasAll(['w', 's', 'n', 'name', 'c', 'at'])
        && request.resource.data.w is int && request.resource.data.w > 0
        && request.resource.data.s in ['a', 'b']
        && request.resource.data.n is number && request.resource.data.n >= 0 && request.resource.data.n <= 1000000000
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.c is string && request.resource.data.c.size() <= 40
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Requests to the bot (hire a truck "haul", "buy" or "sell" goods): the player creates one (money/goods are taken from the player's own save first),
    // the master reads them all, answers with a botres document and deletes the request. No updates, so a request cannot be changed after sending.
    match /botreq/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'kind', 'city', 'dest', 'g', 'q', 'amt', 'at'])
        && request.resource.data.keys().hasAll(['from', 'fromName', 'kind', 'city', 'g', 'q', 'amt', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 20
        && request.resource.data.kind in ['buy', 'sell', 'haul']
        && request.resource.data.city is int && request.resource.data.city >= 0 && request.resource.data.city < 10000
        && (!('dest' in request.resource.data) || (request.resource.data.dest is int && request.resource.data.dest >= 0 && request.resource.data.dest < 10000))
        && request.resource.data.g is string && request.resource.data.g.size() > 0 && request.resource.data.g.size() <= 20
        && request.resource.data.q is int && request.resource.data.q >= 1 && request.resource.data.q <= 1000000
        && request.resource.data.amt is int && request.resource.data.amt >= 0 && request.resource.data.amt <= 1000000
        && request.resource.data.at == request.time;
      allow read: if request.auth != null
        && (request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1' || resource.data.from == request.auth.uid);
      allow delete: if request.auth != null && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1';
    }
    // Bot replies: created only by the developer's save, once per request id (no update, so a reply cannot be re-sent over an existing one).
    // The addressed player reads it, credits cash/goods in their own save, then deletes it.
    match /botres/{id} {
      allow create: if request.auth != null
        && request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1'
        && request.resource.data.keys().hasOnly(['to', 'ok', 'cash', 'city', 'g', 'q', 'msg', 'at'])
        && request.resource.data.keys().hasAll(['to', 'ok', 'cash', 'msg', 'at'])
        && request.resource.data.to is string && request.resource.data.to.size() > 0 && request.resource.data.to.size() <= 128
        && request.resource.data.ok is bool
        && request.resource.data.cash is int && request.resource.data.cash >= 0 && request.resource.data.cash <= 2000000
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 60
        && (!('city' in request.resource.data) || (request.resource.data.city is int && request.resource.data.city >= 0 && request.resource.data.city < 10000))
        && (!('g' in request.resource.data) || (request.resource.data.g is string && request.resource.data.g.size() <= 20))
        && (!('q' in request.resource.data) || (request.resource.data.q is int && request.resource.data.q >= 1 && request.resource.data.q <= 1000000))
        && request.resource.data.at == request.time;
      allow read, delete: if request.auth != null
        && (resource.data.to == request.auth.uid || request.auth.uid == 'BRGRStgYLlbkVbrBTagBrDbpVyg1');
    }
    // Online freight board: a shipper posts a haul (goods + pay are escrowed in the shipper's own save); one carrier accepts; the carrier marks it done; the shipper pays through transfers.
    // Accept = an update that adds {carrier, carrierName, acc, eta} and is only allowed while no carrier is set, so of two racing carriers exactly one commits.
    // Done = the carrier adds {done} with server time between eta and dl. Cancel = shipper deletes before acceptance. Delete after done must come in the same batch as
    // transfers/f<id> paying the carrier the full pay (existsAfter/getAfter), so a haul cannot be settled without paying. An accepted haul that is not done by dl may be deleted by the shipper (refund).
    match /freight/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['shipper', 'shipperName', 'g', 'q', 'from', 'to', 'pay', 'dl', 'at'])
        && request.resource.data.keys().hasAll(['shipper', 'shipperName', 'g', 'q', 'from', 'to', 'pay', 'dl', 'at'])
        && request.resource.data.shipper == request.auth.uid
        && request.resource.data.shipperName is string && request.resource.data.shipperName.size() <= 20
        && request.resource.data.g is string && request.resource.data.g.size() > 0 && request.resource.data.g.size() <= 20
        && request.resource.data.q is int && request.resource.data.q >= 1 && request.resource.data.q <= 5000
        && request.resource.data.from is int && request.resource.data.from >= 0 && request.resource.data.from < 10000
        && request.resource.data.to is int && request.resource.data.to >= 0 && request.resource.data.to < 10000
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.pay is int && request.resource.data.pay >= 100 && request.resource.data.pay <= 1000000
        && request.resource.data.dl is int
        && request.resource.data.dl > request.time.toMillis() + 60000
        && request.resource.data.dl <= request.time.toMillis() + 259200000 + 300000
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && (
        (!('carrier' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['carrier', 'carrierName', 'acc', 'eta'])
          && request.resource.data.keys().hasAll(['carrier', 'carrierName', 'acc', 'eta'])
          && request.resource.data.carrier == request.auth.uid
          && request.auth.uid != resource.data.shipper
          && request.resource.data.carrierName is string && request.resource.data.carrierName.size() <= 20
          && request.resource.data.acc == request.time
          && request.resource.data.eta is int
          && request.resource.data.eta >= request.time.toMillis() + 60000
          && request.resource.data.eta <= resource.data.dl
          && resource.data.dl > request.time.toMillis())
        ||
        ('carrier' in resource.data && !('done' in resource.data)
          && resource.data.carrier == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
          && request.resource.data.done == request.time
          && request.time.toMillis() >= resource.data.eta
          && request.time.toMillis() <= resource.data.dl));
      allow delete: if request.auth != null && resource.data.shipper == request.auth.uid && (
        !('carrier' in resource.data)
        || ('done' in resource.data
            && existsAfter(/databases/$(database)/documents/transfers/$('f' + id))
            && getAfter(/databases/$(database)/documents/transfers/$('f' + id)).data.to == resource.data.carrier
            && getAfter(/databases/$(database)/documents/transfers/$('f' + id)).data.from == request.auth.uid
            && getAfter(/databases/$(database)/documents/transfers/$('f' + id)).data.amt == resource.data.pay)
        || (!('done' in resource.data) && request.time.toMillis() > resource.data.dl));
    }
    // ---- Cartels (online syndicates). Doc id of cartels/{id} is the boss's uid, so a boss founds at most one. ----
    function validCartel(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 20
        && d.tag is string && d.tag.matches('^[A-Z0-9]{2,4}$')
        && d.col is string && d.col.matches('^#[0-9a-fA-F]{6}$')
        && d.open is bool
        && d.bossName is string && d.bossName.size() <= 20
        && (d.fix == null || (d.fix is map && d.fix.keys().hasOnly(['c', 'g']) && d.fix.keys().hasAll(['c', 'g'])
            && d.fix.c is int && d.fix.c >= 0 && d.fix.c < 10000
            && d.fix.g is string && d.fix.g.size() > 0 && d.fix.g.size() <= 20));
    }
    // the ledger entry that belongs to treasury change number seq of cartel cid (as it will be after the batch)
    function ledAfter(cid, seq) {
      return getAfter(/databases/$(database)/documents/cled/$(cid + '_' + string(seq))).data;
    }
    function payTransferOk(cid, seq, boss, to, amt) {
      return existsAfter(/databases/$(database)/documents/transfers/$('c' + cid + '_' + string(seq)))
        && getAfter(/databases/$(database)/documents/transfers/$('c' + cid + '_' + string(seq))).data.to == to
        && getAfter(/databases/$(database)/documents/transfers/$('c' + cid + '_' + string(seq))).data.from == boss
        && getAfter(/databases/$(database)/documents/transfers/$('c' + cid + '_' + string(seq))).data.amt == amt;
    }
    function isMember(cid) {
      return request.auth.uid in get(/databases/$(database)/documents/cartels/$(cid)).data.members;
    }
    function isBoss(cid) {
      return get(/databases/$(database)/documents/cartels/$(cid)).data.boss == request.auth.uid;
    }
    match /cartels/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['name', 'tag', 'col', 'boss', 'bossName', 'open', 'members', 'tre', 'seq', 'fix', 'fixAt', 'at'])
        && request.resource.data.keys().hasAll(['name', 'tag', 'col', 'boss', 'bossName', 'open', 'members', 'tre', 'seq', 'fix', 'fixAt', 'at'])
        && validCartel(request.resource.data)
        && request.resource.data.boss == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.tre == 0 && request.resource.data.seq == 0
        && request.resource.data.fix == null && request.resource.data.fixAt == 0
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && (
        // boss: settings and price fixing (price fixing may change once per 12 hours)
        (request.auth.uid == resource.data.boss
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'tag', 'col', 'open', 'bossName', 'fix', 'fixAt'])
          && validCartel(request.resource.data)
          && request.resource.data.fixAt is int
          && (('fix' in request.resource.data.diff(resource.data).affectedKeys())
              ? (request.resource.data.fixAt >= request.time.toMillis() - 300000
                 && request.resource.data.fixAt <= request.time.toMillis() + 300000
                 && request.time.toMillis() >= resource.data.fixAt + 43200000)
              : !('fixAt' in request.resource.data.diff(resource.data).affectedKeys())))
        ||
        // boss removes a member (the boss stays)
        (request.auth.uid == resource.data.boss
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
          && request.resource.data.members.hasAll([resource.data.boss]))
        ||
        // a member (not the boss) leaves
        (request.auth.uid != resource.data.boss && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
          && !(request.auth.uid in request.resource.data.members))
        ||
        // a player joins themselves; needs the boss's invite, which must be consumed (deleted) in the same batch
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 12
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()).size() == 0
          && request.auth.uid in request.resource.data.members
          && exists(/databases/$(database)/documents/cjoin/$(id + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/cjoin/$(id + '_' + request.auth.uid)).data.kind == 'invite'
          && !existsAfter(/databases/$(database)/documents/cjoin/$(id + '_' + request.auth.uid)))
        ||
        // treasury: exactly one ledger entry per change (member deposit, or boss payout)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tre', 'seq'])
          && request.resource.data.seq == resource.data.seq + 1
          && request.resource.data.tre >= 0 && request.resource.data.tre <= 1000000000
          && existsAfter(/databases/$(database)/documents/cled/$(id + '_' + string(request.resource.data.seq)))
          && ledAfter(id, request.resource.data.seq).cid == id
          && ledAfter(id, request.resource.data.seq).uid == request.auth.uid
          && ((ledAfter(id, request.resource.data.seq).kind == 'in'
                && request.auth.uid in resource.data.members
                && request.resource.data.tre == resource.data.tre + ledAfter(id, request.resource.data.seq).amt)
              || (ledAfter(id, request.resource.data.seq).kind == 'out'
                && request.auth.uid == resource.data.boss
                && ledAfter(id, request.resource.data.seq).to in resource.data.members
                && request.resource.data.tre == resource.data.tre - ledAfter(id, request.resource.data.seq).amt
                && (ledAfter(id, request.resource.data.seq).to == request.auth.uid
                    || payTransferOk(id, request.resource.data.seq, request.auth.uid, ledAfter(id, request.resource.data.seq).to, ledAfter(id, request.resource.data.seq).amt))))));
      // the boss may disband an empty cartel with an empty treasury
      allow delete: if request.auth != null && request.auth.uid == resource.data.boss
        && resource.data.members.size() == 1 && resource.data.tre == 0;
    }
    // Join invitations (kind 'invite', written by the boss) and join requests (kind 'request', written by the player, approved by the boss flipping it to 'invite').
    match /cjoin/{jid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['cid', 'uid', 'name', 'kind', 'at'])
        && request.resource.data.keys().hasAll(['cid', 'uid', 'name', 'kind', 'at'])
        && request.resource.data.cid is string && request.resource.data.uid is string
        && jid == request.resource.data.cid + '_' + request.resource.data.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.at == request.time
        && !(request.resource.data.uid in get(/databases/$(database)/documents/cartels/$(request.resource.data.cid)).data.members)
        && ((request.resource.data.kind == 'request' && request.resource.data.uid == request.auth.uid
              && get(/databases/$(database)/documents/cartels/$(request.resource.data.cid)).data.open == true)
            || (request.resource.data.kind == 'invite' && isBoss(request.resource.data.cid)));
      allow update: if request.auth != null && isBoss(resource.data.cid)
        && resource.data.kind == 'request'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind', 'at'])
        && request.resource.data.kind == 'invite' && request.resource.data.at == request.time;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.uid || isBoss(resource.data.cid));
    }
    // Permanent, create-only treasury ledger. Entry n of a cartel can only be created together with the cartel update that moves seq from n-1 to n.
    match /cled/{lid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['cid', 'seq', 'kind', 'uid', 'to', 'amt', 'at'])
        && request.resource.data.keys().hasAll(['cid', 'seq', 'kind', 'uid', 'amt', 'at'])
        && request.resource.data.cid is string && request.resource.data.seq is int && request.resource.data.seq >= 1
        && lid == request.resource.data.cid + '_' + string(request.resource.data.seq)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['in', 'out']
        && request.resource.data.amt is int && request.resource.data.amt >= 1 && request.resource.data.amt <= 1000000
        && request.resource.data.at == request.time
        && (request.resource.data.kind == 'out'
            ? ('to' in request.resource.data && request.resource.data.to is string)
            : !('to' in request.resource.data))
        && get(/databases/$(database)/documents/cartels/$(request.resource.data.cid)).data.seq == request.resource.data.seq - 1
        && getAfter(/databases/$(database)/documents/cartels/$(request.resource.data.cid)).data.seq == request.resource.data.seq;
      allow update, delete: if false;
    }
    // Members-only chat. One message per ~4 s per player: the same batch must stamp cmlast/{uid} with the server time and the previous stamp must be old enough.
    match /cmsg/{mid} {
      allow read: if request.auth != null && isMember(resource.data.cid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['cid', 'uid', 'name', 'txt', 'at'])
        && request.resource.data.keys().hasAll(['cid', 'uid', 'name', 'txt', 'at'])
        && request.resource.data.cid is string && isMember(request.resource.data.cid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.txt is string && request.resource.data.txt.size() >= 1 && request.resource.data.txt.size() <= 120
        && request.resource.data.at == request.time
        && existsAfter(/databases/$(database)/documents/cmlast/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/cmlast/$(request.auth.uid)).data.at == request.time
        && (!exists(/databases/$(database)/documents/cmlast/$(request.auth.uid))
            || get(/databases/$(database)/documents/cmlast/$(request.auth.uid)).data.at.toMillis() < request.time.toMillis() - 4000);
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isBoss(resource.data.cid));
      allow update: if false;
    }
    match /cmlast/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      // the owner may remove it when deleting their account
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Government raid on a price-fixing cartel: at most one per cartel per day. The raider's own profile must carry gov == true (published by the client while it holds an office; self-reported, so this blocks casual raids, not a determined cheat).
    match /craid/{cid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['cid', 'by', 'byName', 'at'])
        && request.resource.data.keys().hasAll(['cid', 'by', 'byName', 'at'])
        && request.resource.data.cid == cid && request.resource.data.by == request.auth.uid
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 20
        && request.resource.data.at == request.time
        && !(request.auth.uid in get(/databases/$(database)/documents/cartels/$(cid)).data.members)
        && get(/databases/$(database)/documents/cartels/$(cid)).data.fix != null
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.get('gov', false) == true
        && (resource == null || resource.data.at.toMillis() < request.time.toMillis() - 86400000);
      allow delete: if false;
    }
    // Nuclear mining permit applications. The applicant creates a pending request addressed to the player
    // governing that country; only that governor may approve or refuse it; the applicant may withdraw it.
    match /permits/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && id.matches(request.auth.uid + '_[A-Za-z0-9]{0,30}')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'c', 'by', 'st', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.c is string && request.resource.data.c.size() <= 40
        && request.resource.data.by is string && request.resource.data.by != request.auth.uid
        && request.resource.data.st == 'pending'
        && request.resource.data.at == request.time;
      // The addressed governor decides once: only st/by/byName may change, and by stays the governor.
      allow update: if request.auth != null
        && resource.data.st == 'pending'
        && resource.data.by == request.auth.uid
        && request.resource.data.by == request.auth.uid
        && request.resource.data.st in ['approved', 'denied']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'byName'])
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 20;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Cabinet (Military dashboard > Cabinet): office holders of one country. Office comes from the player's own public profile
    // (govC / govR, published by the game), so this keeps out non-holders, not a determined cheat.
    function me() {
      return get(/databases/$(database)/documents/players/$(request.auth.uid)).data;
    }
    function govOf(c) {
      return request.auth != null && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && me().get('govC', '') == c && me().get('govR', -1) >= 0;
    }
    function govAny() {
      return request.auth != null && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && me().get('govR', -1) >= 0;
    }
    function govLeader(c) {
      return govOf(c) && me().get('govR', -1) == 2;
    }
    function validGovMsg(d, c) {
      return d.keys().hasOnly(['uid', 'name', 'c', 'r', 'txt', 'at'])
        && d.keys().hasAll(['uid', 'name', 'c', 'r', 'txt', 'at'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() <= 20
        && d.c == c && d.r is int && d.r >= 0 && d.r <= 2
        && d.txt is string && d.txt.size() >= 1 && d.txt.size() <= 160
        && d.at == request.time
        && getAfter(/databases/$(database)/documents/gvlast/$(request.auth.uid)).data.at == request.time
        && (!exists(/databases/$(database)/documents/gvlast/$(request.auth.uid))
            || get(/databases/$(database)/documents/gvlast/$(request.auth.uid)).data.at.toMillis() < request.time.toMillis() - 3000);
    }
    match /gvlast/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Chat for every office holder in the world.
    match /govmsg/{mid} {
      allow read: if govAny();
      allow create: if govAny() && validGovMsg(request.resource.data, me().get('govC', ''));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    // Shared funds of one country's cabinet: members add money; spending happens in a transaction by the Leader.
    match /cab/{c} {
      allow read: if govOf(c);
      allow create, update: if govOf(c)
        && request.resource.data.keys().hasOnly(['war', 'arms', 'wto'])
        && (!('war' in request.resource.data) || (request.resource.data.war is number && request.resource.data.war >= 0 && request.resource.data.war <= 1e12))
        && (!('arms' in request.resource.data) || (request.resource.data.arms is number && request.resource.data.arms >= 0 && request.resource.data.arms <= 1e12))
        && (!('wto' in request.resource.data) || (request.resource.data.wto is number && request.resource.data.wto >= 0 && request.resource.data.wto <= 1e12))
        // only the Leader may lower a fund
        && (govLeader(c) || resource == null
            || (request.resource.data.get('war', 0) >= resource.data.get('war', 0)
                && request.resource.data.get('arms', 0) >= resource.data.get('arms', 0)
                && request.resource.data.get('wto', 0) >= resource.data.get('wto', 0)));
      allow delete: if false;

      match /msg/{mid} {
        allow read: if govOf(c);
        allow create: if govOf(c) && validGovMsg(request.resource.data, c);
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
      // Bills: majority of seats passes, the Leader may veto, the Leader marks spending bills done.
      match /bill/{bid} {
        allow read: if govOf(c);
        allow create: if govOf(c)
          && request.resource.data.keys().hasOnly(['k', 'key', 'val', 'tg', 'by', 'byName', 'at', 'exp', 'seats', 'yes', 'no', 'st', 'done'])
          && request.resource.data.k in ['law', 'war', 'arms', 'wto']
          && request.resource.data.key is string && request.resource.data.key.size() <= 12
          && request.resource.data.val is int && request.resource.data.val >= 0 && request.resource.data.val <= 9
          && request.resource.data.tg is string && request.resource.data.tg.size() <= 40
          && request.resource.data.by == request.auth.uid
          && request.resource.data.byName is string && request.resource.data.byName.size() <= 20
          && request.resource.data.at == request.time
          && request.resource.data.exp is timestamp
          && request.resource.data.seats is int && request.resource.data.seats >= 1 && request.resource.data.seats <= 10
          && request.resource.data.yes == [request.auth.uid] && request.resource.data.no == []
          && request.resource.data.st == 'open' && request.resource.data.done == false;
        // a vote adds only your own uid to yes or no, while the bill is open and before its deadline
        allow update: if govOf(c) && resource.data.st == 'open' && request.time < resource.data.exp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yes', 'no', 'st'])
          && request.resource.data.yes.toSet().difference(resource.data.yes.toSet()).hasOnly([request.auth.uid])
          && request.resource.data.no.toSet().difference(resource.data.no.toSet()).hasOnly([request.auth.uid])
          && !(request.auth.uid in resource.data.yes) && !(request.auth.uid in resource.data.no)
          && request.resource.data.st in ['open', 'passed', 'failed'];
        allow update: if govLeader(c) && resource.data.st == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])
          && request.resource.data.st == 'vetoed';
        allow update: if govLeader(c) && resource.data.done == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
          && request.resource.data.done == true;
        allow delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
